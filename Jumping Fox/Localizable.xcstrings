    "modeIntro.tables.multiplyBy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each table times a number from |1 to 12|."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke tafel keer een getal van |1 tot 12|."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke tafel maal ’n getal van |1 tot 12|."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Çdo tabelë shumëzohet me një numër nga |1 deri në 12|."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "እያንዳንዱ ሰንጠረዥ ከ|1 እስከ 12| ባለ ቁጥር ይባዛል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل جدول مضروب في عدد من |1 إلى 12|."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Յուրաքանչյուր աղյուսակը բազմապատկվում է |1-ից 12| թվով։"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "প্ৰতিটো নামতা |১ৰ পৰা ১২|লৈ এটা সংখ্যাৰে পূৰণ কৰা।"
          }
