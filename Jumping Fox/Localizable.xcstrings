    "notif.streak.body %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play for %lld minutes and keep it going!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speel %lld minuten en houd je reeks vast!"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Speel vir %lld minute en hou jou daaglikse speelreeks aan die gang!"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Luaj për %lld minuta dhe vazhdo serinë e përditshme të lojës!"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ለ %lld ደቂቃዎች ይጫወቱ እና የእለት ተእለት ጨዋታዎን ይቀጥሉ!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العب لمدة %lld دقائق وحافظ على استمرار خط لعبك اليومي!"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Խաղացեք %lld րոպե և շարունակեք ձեր ամենօրյա խաղային շարանը:"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld মিনিট খেলক আৰু আপোনাৰ দৈনন্দিন খেলাৰ ধাৰাটো চলি থাকিব!"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dəqiqə oynayın və gündəlik oyun seriyanızı davam etdirin!"
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokatu %lld minutuz eta mantendu zure eguneroko jolas-boluari!"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld মিনিটের জন্য খেলুন এবং আপনার প্রতিদিনের খেলার ধারা অব্যাহত রাখুন!"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld မိနစ်လောက်ကစားပြီး သင့်နေ့စဥ်ကစားခြင်းကို ဆက်လက်လုပ်ဆောင်ပါ။"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Igrajte %lld minuta i nastavite svoj dnevni niz igranja!"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Играйте %lld минути и продължете ежедневната си серия от игри!"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Juga durant %lld minuts i manté la teva ratxa diària de joc!"
