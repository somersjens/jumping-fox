    "modeIntro.fractionsMix.b1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work out a part of a whole and make fractions equal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reken een deel van een geheel uit en maak breuken gelijk."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereken ’n deel van ’n geheel en maak breuke gelyk."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjej një pjesë të së tërës dhe bëji thyesat të barabarta."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የሙሉ ነገርን ክፍል አስላ እና እኩል ክፍልፋዮችን ፍጠር።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احسب جزءًا من كل، واجعل الكسور متساوية."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաշվիր ամբողջի մի մասը և հավասարեցրու կոտորակները։"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "এটা সম্পূৰ্ণৰ অংশ উলিওৱা আৰু ভগ্নাংশ সমান কৰা।"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamın bir hissəsini hesabla və kəsrləri bərabərləşdir."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalkulatu osotasun baten zati bat eta egin zatiki baliokideak."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি সম্পূর্ণের অংশ হিসাব করো এবং সমান ভগ্নাংশ বানাও।"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "တစ်ခုလုံးရဲ့ အပိုင်းကိုတွက်ပြီး အပိုင်းကိန်းတွေ ညီအောင်လုပ်ပါ။"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Izračunaj dio cjeline i pronađi jednake razlomke."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Намери част от цяло и прави дробите равни."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcula una part d’un tot i fes fraccions equivalents."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "算出整体的一部分，并找出相等的分数。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beregn en del af en helhed, og gør brøker lige store."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechne einen Teil eines Ganzen und erweitere oder kürze Brüche."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia osa tervikust ja tee murrud võrdseks."
          }
        },
        "fo": {
          "stringUnit": {
            "state": "translated",
            "value": "Rokna ein part av einum heilum og ger brot javnstór."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Laske osa kokonaisuudesta ja tee murtoluvuista yhtä suuria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcule une part d’un tout et trouve des fractions égales."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcula unha parte dun todo e crea fraccións equivalentes."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გამოთვალე მთელის ნაწილი და გაათანაბრე წილადები."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βρες ένα μέρος του όλου και φτιάξε ισοδύναμα κλάσματα."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પૂર્ણ સંખ્યાનો એક ભાગ ગણો અને અપૂર્ણાંકો સમાન બનાવો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חשבו חלק מתוך שלם וצרו שברים שווים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी पूर्ण का भाग निकालो और भिन्नों को बराबर बनाओ।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Számold ki egy egész részét, és alakíts egyenlővé törteket."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Ríomh cuid d’iomlán agus déan codáin cothrom."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Reiknaðu hluta af heild og gerðu brot jafngild."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hitung bagian dari keseluruhan dan buat pecahan senilai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcola una parte di un intero e trova frazioni equivalenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全体の一部を計算し、同じ大きさの分数を作ろう。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪೂರ್ಣದ ಒಂದು ಭಾಗ ಕಂಡುಹಿಡಿದು ಭಿನ್ನರಾಶಿಗಳನ್ನು ಸಮಮಾಡು."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүтіннің бір бөлігін есептеп, бөлшектерді теңестір."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គណនាផ្នែកមួយនៃចំនួនទាំងមូល ហើយធ្វើឱ្យប្រភាគស្មើគ្នា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체의 일부를 구하고 같은 크기의 분수를 만들어요."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izračunaj dio cjeline i načini jednake razlomke."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຫາສ່ວນໜຶ່ງຂອງທັງໝົດ ແລະ ເຮັດໃຫ້ເສດສ່ວນເທົ່າກັນ."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprēķini daļu no veseluma un atrodi vienādus daļskaitļus."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apskaičiuok visumos dalį ir rask lygiavertes trupmenas."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пресметај дел од целина и изедначувај дропки."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kira satu bahagian daripada keseluruhan dan samakan pecahan."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു പൂർണ്ണത്തിന്റെ ഭാഗം കണ്ടുപിടിച്ച് തുല്യഭിന്നങ്ങൾ ഉണ്ടാക്കൂ."
          }
        },
        "mr": {
