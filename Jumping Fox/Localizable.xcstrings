          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ болон |өмнөх түвшний| хувиуд орно."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तिमीले यो लेभल र |अघिल्ला लेभल| का प्रतिशत पाउँछौ।"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Du får prosentoppgaver fra dette nivået og |tidligere nivåer|."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут будуть відсотки з цього й |попередніх рівнів|."
