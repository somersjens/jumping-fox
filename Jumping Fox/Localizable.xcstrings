        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "ھەر بىر ھايۋان پۈتۈن ئويۇنغا ئۆزىنىڭ رەڭ ئۇسلۇبىنى بېرىدۇ."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Har bir hayvon butun o‘yinga o‘z rang mavzusini beradi."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر حیوان، رنگ‌وبوی خودش را به کل بازی می‌دهد."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde zwierzę nadaje całej grze własny motyw kolorystyczny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada animal dá ao jogo inteiro o seu próprio tema de cores."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਰ ਜਾਨਵਰ ਪੂਰੀ ਖੇਡ ਲਈ ਆਪਣਾ ਰੰਗੀਨ ਥੀਮ ਲਿਆਉਂਦਾ ਹੈ।"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare animal aduce propria temă de culori în tot jocul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждое животное меняет цветовую тему всей игры."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaka životinja daje celoj igri svoju temu boja."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "සෑම සතෙකුම මුළු ක්‍රීඩාවටම තමන්ගේම වර්ණ තේමාවක් දෙයි."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé zviera prinesie do celej hry vlastnú farebnú tému."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsaka žival obarva celotno igro s svojo barvno temo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada animal da su propio tema de color a todo el juego."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kila mnyama huupa mchezo mzima mandhari yake ya rangi."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு விலங்கும் முழு விளையாட்டிற்கும் தனித்த நிறத் தோற்றத்தைத் தரும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి జంతువు ఆట మొత్తానికి తనదైన రంగుల రూపాన్ని ఇస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สัตว์แต่ละตัวมีธีมสีของตัวเองทั้งเกม"
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "སྲོག་ཆགས་རེས་རྩེད་མོ་ཧྲིལ་པོར་རང་གི་ཁ་དོག་གི་བཟོ་ལྟ་སྟེར།"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každé zvíře přinese celé hře vlastní barevný motiv."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her hayvan tüm oyuna kendi renk temasını getirir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر جانور پورے کھیل کو اپنا رنگین تھیم دیتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi con vật mang một chủ đề màu riêng cho toàn bộ trò chơi."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae pob anifail yn rhoi ei thema liw ei hun i'r gêm gyfan."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожная жывёла дадае гульні сваю каляровую тэму."
          }
        },
        "zu": {
          "stringUnit": {
