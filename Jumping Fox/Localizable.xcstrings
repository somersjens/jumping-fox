        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक प्राणी संपूर्ण खेळाला स्वतःची रंगसंगती देतो."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Амьтан бүр тоглоомд өөрийн өнгөний загварыг өгнө."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "हरेक जनावरले पूरै खेलमा आफ्नै रङको थिम ल्याउँछ।"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert dyr gir hele spillet sitt eget fargetema."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожна тварина додає грі власну кольорову тему."
