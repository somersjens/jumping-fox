    "game.intro.helperBullet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The correct answer is highlighted in green because the helper is on. Trophies are therefore counted separately with *."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het goede antwoord is groen gemarkeerd omdat de helper aanstaat. Trofeeën worden daarom apart geteld met *."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die regte antwoord is groen gemerk omdat die helper aan is. Trofeë word daarom apart met * getel."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Përgjigjja e saktë është me të gjelbër sepse ndihmësi është aktiv. Prandaj, trofetë numërohen veç me *."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ረዳቱ ስለበራ ትክክለኛው መልስ በአረንጓዴ ይታያል። ስለዚህ ዋንጫዎች በ* ለብቻቸው ይቆጠራሉ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإجابة الصحيحة مميزة بالأخضر لأن المساعد مفعّل. لذلك تُحسب الكؤوس بشكل منفصل مع *."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ճիշտ պատասխանը կանաչ է, քանի որ օգնականը միացված է։ Այդ պատճառով գավաթները *-ով առանձին են հաշվվում։"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "সহায়ক চালু থকাৰ বাবে সঠিক উত্তৰটো সেউজীয়া। সেয়ে ট্ৰফী * চিহ্নেৰে পৃথকে গণনা হয়।"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Köməkçi aktiv olduğu üçün düzgün cavab yaşıl göstərilir. Buna görə kuboklar * ilə ayrıca sayılır."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Erantzun zuzena berdez nabarmenduta dago laguntzailea aktibatuta dagoelako. Horregatik, garaikurrak aparte zenbatzen dira * ikurrarekin."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সহায়ক চালু থাকায় সঠিক উত্তর সবুজ দেখানো হয়। তাই * দিয়ে ট্রফি আলাদা গোনা হয়।"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အကူမုဒ်ဖွင့်ထားလို့ အဖြေမှန်ကို အစိမ်းရောင်နဲ့ ပြထားတယ်။ ဒါကြောင့် ဆုဖလားတွေကို * နဲ့ သီးခြားရေတွက်မယ်။"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tačan odgovor je označen zeleno jer je pomoćnik uključen. Trofeji se zato broje odvojeno sa *."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Верният отговор е оцветен в зелено, защото помощникът е включен. Затова трофеите се броят отделно със *."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La resposta correcta es destaca en verd perquè l’ajuda està activada. Per això, els trofeus es compten a part amb *."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助模式已开启，正确答案会显示为绿色。因此，带 * 的奖杯会单独计算。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det rigtige svar er markeret med grønt, fordi hjælpen er slået til. Pokaler tælles derfor separat med *."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die richtige Antwort ist grün markiert, weil die Hilfe an ist. Deshalb werden Pokale mit * getrennt gezählt."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Õige vastus on rohelisega märgitud, sest abiline on sees. Seepärast loetakse *-ga karikad eraldi."
          }
        },
        "fo": {
          "stringUnit": {
            "state": "translated",
            "value": "Rætta svarið er grønt, tí hjálpin er tendrað. Steyp verða tí tald fyri seg við *."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oikea vastaus näkyy vihreänä, koska apuri on päällä. Siksi tähdellä * merkityt pokaalit lasketaan erikseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La bonne réponse est surlignée en vert car l’aide est activée. Les trophées sont donc comptés séparément avec *."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "A resposta correcta aparece en verde porque a axuda está activada. Por iso, os trofeos cóntanse á parte cun *."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სწორი პასუხი მწვანედაა მონიშნული, რადგან დამხმარე ჩართულია. ამიტომ თასები *-ით ცალკე ითვლება."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σωστή απάντηση φαίνεται με πράσινο επειδή είναι ενεργή η βοήθεια. Γι’ αυτό τα τρόπαια μετριούνται χωριστά με *."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મદદ ચાલુ હોવાથી સાચો જવાબ લીલો દેખાય છે. તેથી ટ્રોફીઓ * સાથે અલગ ગણાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התשובה הנכונה מסומנת בירוק כי העזרה פועלת. לכן גביעים נספרים בנפרד עם *."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहायक चालू होने से सही उत्तर हरे रंग में दिखता है। इसलिए * वाली ट्रॉफियाँ अलग गिनी जाती हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A helyes válasz zöld, mert a segítség be van kapcsolva. A trófeákat ezért külön, * jellel számoljuk."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá an freagra ceart glas mar tá an cúntóir ar siúl. Déantar trófaithe a chomhaireamh ar leithligh le * dá bharr."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétta svarið er merkt grænt því hjálpin er virk. Bikarar teljast því sér með *."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawaban yang benar ditandai hijau karena bantuan aktif. Jadi, trofi dihitung terpisah dengan *."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La risposta corretta è evidenziata in verde perché l’aiuto è attivo. I trofei vengono quindi contati a parte con *."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おたすけがオンなので、正しい答えが緑色になります。そのため、トロフィーは*付きで別に数えます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಹಾಯಕ ಆನ್ ಇರುವುದರಿಂದ ಸರಿಯಾದ ಉತ್ತರ ಹಸಿರಿನಲ್ಲಿ ಕಾಣುತ್ತದೆ. ಆದ್ದರಿಂದ ಟ್ರೋಫಿಗಳನ್ನು * ಗುರುತಿನಿಂದ ಬೇರೆ ಎಣಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "kk": {
          "stringUnit": {
