        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دستگاهت را حرکت بده تا چپ و راست بروی. از کناره‌های صفحه هم می‌توانی رد شوی."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poruszaj urządzeniem, aby iść w lewo lub w prawo. Możesz też przechodzić przez boki ekranu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Move o dispositivo para ires para a esquerda e para a direita. Também podes passar pelos lados do ecrã."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਖੱਬੇ-ਸੱਜੇ ਜਾਣ ਲਈ ਆਪਣਾ ਡਿਵਾਈਸ ਹਿਲਾਓ। ਤੁਸੀਂ ਸਕ੍ਰੀਨ ਦੇ ਪਾਸਿਆਂ ਰਾਹੀਂ ਵੀ ਲੰਘ ਸਕਦੇ ਹੋ।"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mișcă dispozitivul spre stânga și dreapta. Poți trece și prin marginile ecranului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наклоняй устройство, чтобы двигаться влево и вправо. Можно также проходить через края экрана."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomeraj uređaj da ideš levo i desno. Možeš da prođeš i kroz ivice ekrana."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "වමට හා දකුණට යන්න උපාංගය හලවන්න. තිරයේ පැති හරහාත් යන්න පුළුවන්."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakláňaj zariadenie doľava a doprava. Môžeš prejsť aj cez okraje obrazovky."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Premikaj napravo, da greš levo in desno. Premikaš se lahko tudi skozi robova zaslona."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve el dispositivo para ir a izquierda y derecha. También puedes atravesar los lados de la pantalla."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Sogeza kifaa chako kwenda kushoto na kulia. Unaweza pia kupita kwenye pande za skrini."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இடப்புறமும் வலப்புறமும் செல்ல சாதனத்தை அசை. திரையின் ஓரங்கள் வழியாகவும் செல்லலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎడమకు, కుడికి వెళ్లడానికి పరికరాన్ని కదిలించు. తెర అంచుల గుండా కూడా వెళ్లవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขยับอุปกรณ์เพื่อไปทางซ้ายและขวา และยังทะลุขอบจอไปอีกฝั่งได้"
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "གཡོན་དང་གཡས་སུ་འགྲོ་བར་ཁྱེད་ཀྱི་ཡོ་བྱད་སྒུལ། བརྙན་ཡོལ་གྱི་ཟུར་ནས་ཀྱང་བརྒྱུད་ཆོག"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakláněj zařízení doleva a doprava. Můžeš také procházet přes okraje obrazovky."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sola ve sağa gitmek için cihazını hareket ettir. Ekranın kenarlarından da geçebilirsin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دائیں بائیں جانے کے لیے آلہ ہلائیں۔ آپ اسکرین کے کناروں سے بھی گزر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nghiêng thiết bị để di chuyển sang trái và phải. Bạn cũng có thể đi xuyên qua hai bên màn hình."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Symuda dy ddyfais i fynd i'r chwith a'r dde. Gelli di hefyd symud drwy ochrau'r sgrin."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Нахіляй прыладу, каб рухацца ўлева і ўправа. Можна таксама праходзіць праз бакі экрана."
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyakazisa idivayisi yakho ukuze uye kwesokunxele nakwesokudla. Ungaphinde udlule emaceleni esikrini."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Luta enheten för att gå åt vänster och höger. Du kan också gå genom skärmens kanter."
          }
        }
      }
    },
