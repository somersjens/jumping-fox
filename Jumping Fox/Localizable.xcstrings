    "developerMode.accessibilityHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press and hold for 2 seconds to open developer mode."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd 2 seconden ingedrukt voor ontwikkelaarsmodus."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk en hou vir 2 sekondes om ontwikkelaarmodus oop te maak."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Mbaje shtypur për 2 sekonda për të hapur modalitetin e zhvilluesit."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የገንቢ ሁነታን ለመክፈት ለ2 ሰከንድ ተጭነህ ያዝ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا لمدة ثانيتين لفتح وضع المطوّر."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սեղմած պահիր 2 վայրկյան՝ մշակողի ռեժիմը բացելու համար։"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "ডেভেলপাৰ মোড খোলিবলৈ ২ ছেকেণ্ড ধৰি ৰাখা।"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tərtibatçı rejimini açmaq üçün 2 saniyə basıb saxla."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eduki sakatuta 2 segundoz garatzaile-modua irekitzeko."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডেভেলপার মোড খুলতে ২ সেকেন্ড চেপে ধরো।"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "တီထွင်သူမုဒ်ဖွင့်ရန် ၂ စက္ကန့် ဖိထားပါ။"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pritisni i drži 2 sekunde za razvojni način."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Задръж за 2 секунди, за да отвориш режима за разработчици."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén premut durant 2 segons per obrir el mode desenvolupador."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "长按 2 秒打开开发者模式。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold nede i 2 sekunder for at åbne udviklertilstand."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte 2 Sekunden gedrückt, um den Entwicklermodus zu öffnen."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Arendajarežiimi avamiseks hoia 2 sekundit all."
          }
        },
        "fo": {
          "stringUnit": {
            "state": "translated",
            "value": "Halt inni í 2 sekund fyri at lata menningarstøðu upp."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa kehittäjätila pitämällä painettuna 2 sekuntia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens appuyé pendant 2 secondes pour ouvrir le mode développeur."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén premido 2 segundos para abrir o modo de desenvolvemento."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დეველოპერის რეჟიმის გასახსნელად 2 წამით დააჭირე."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κράτησέ το πατημένο για 2 δευτερόλεπτα για να ανοίξεις τη λειτουργία προγραμματιστή."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ડેવલપર મોડ ખોલવા 2 સેકન્ડ દબાવી રાખો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחצו לחיצה ארוכה במשך 2 שניות כדי לפתוח מצב מפתחים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डेवलपर मोड खोलने के लिए 2 सेकंड दबाकर रखें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsd nyomva 2 másodpercig a fejlesztői mód megnyitásához."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Brúigh agus coinnigh ar feadh 2 shoicind chun mód an fhorbróra a oscailt."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Haltu inni í 2 sekúndur til að opna þróunarstillingu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan dan tahan selama 2 detik untuk membuka mode pengembang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto per 2 secondi per aprire la modalità sviluppatore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2秒間長押しすると、開発者モードが開きます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಡೆವಲಪರ್ ಮೋಡ್ ತೆರೆಯಲು 2 ಸೆಕೆಂಡ್ ಒತ್ತಿಹಿಡಿ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әзірлеуші режимін ашу үшін 2 секунд басып тұрыңыз."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចុចឱ្យជាប់ 2 វិនាទី ដើម្បីបើករបៀបអ្នកអភិវឌ្ឍន៍។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개발자 모드를 열려면 2초 동안 길게 누르세요."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pritisni i drži 2 sekunde za otvaranje razvojnog načina."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ກົດຄ້າງ 2 ວິນາທີເພື່ອເປີດໂໝດນັກພັດທະນາ."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Turiet nospiestu 2 sekundes, lai atvērtu izstrādātāja režīmu."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
