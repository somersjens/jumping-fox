        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ତୁମେ ଏହି ଲେଭେଲ୍ ଓ |ଆଗର ଲେଭେଲ୍‌ଗୁଡ଼ିକର| ଶତକଡ଼ା ପାଇବ।"
