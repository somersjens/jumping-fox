        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "%@টো %lld ছেকেণ্ড ধৰি ৰাখা।"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ üzərində %lld saniyə basıb saxla."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eduki %@ sakatuta %lld segundoz."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-টি %lld সেকেন্ড চেপে ধরুন।"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ကို %lld စက္ကန့် ဖိထားပါ။"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Drži %@ %lld sekundi."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Задръж %@ за %lld секунди."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén premut el %@ durant %lld segons."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 %@ %lld 秒。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold %@ nede i %lld sekunder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte %@ %lld Sekunden gedrückt."
