        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వరుస లక్ష్యం రోజుకు 5 నిమిషాల నుంచి మొదలవుతుంది. చురుకుగా ఆడిన సమయం మాత్రమే లెక్కలోకి వస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เป้าหมายต่อเนื่องเริ่มที่วันละ 5 นาที นับเฉพาะเวลาเล่นจริง"
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "བསྟུད་མར་རྩེ་བའི་དམིགས་ཡུལ་ཉིན་རེར་སྐར་མ་5 ནས་འགོ་འཛུགས། དངོས་སུ་རྩེ་བའི་དུས་ཚོད་ཁོ་ན་བརྩི།"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cíl série začíná na 5 minutách denně. Počítá se jen aktivní hraní."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seri hedefi günde 5 dakikayla başlar. Yalnızca aktif oyun süresi sayılır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مسلسل کھیل کا ہدف روز 5 منٹ سے شروع ہوتا ہے۔ صرف کھیلنے کا اصل وقت گنا جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuỗi ngày bắt đầu với mục tiêu 5 phút mỗi ngày. Chỉ thời gian chơi thực tế được tính."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae nod y gyfres yn dechrau ar 5 munud y dydd. Dim ond amser chwarae gweithredol sy'n cyfrif."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Мэта серыі пачынаецца з 5 хвілін штодня. Залічваецца толькі час актыўнай гульні."
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Umgomo wokulandelana uqala ngemizuzu emi-5 ngosuku. Kubalwa kuphela isikhathi sokudlala ngempela."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svitmålet börjar på 5 minuter per dag. Bara aktiv speltid räknas."
          }
        }
      }
    },
