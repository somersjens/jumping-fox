    "options.capAt30.info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each level has a trophy goal of up to 50. If this option is on, the game finishes automatically when you reach it."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk level heeft een trofeedoel van maximaal 50. Als deze optie aanstaat, wordt het spel automatisch beëindigd zodra je dat haalt."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke vlak het ’n trofeedoel van hoogstens 50. As hierdie opsie aan is, eindig die spel vanself wanneer jy dit bereik."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Çdo nivel ka një objektiv deri në 50 trofe. Kur ky opsion është aktiv, loja mbaron vetë sapo ta arrish."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "እያንዳንዱ ደረጃ እስከ 50 የሚደርስ የዋንጫ ግብ አለው። ይህ አማራጭ ከበራ፣ ግቡን ስትደርስ ጨዋታው በራሱ ይጠናቀቃል።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لكل مستوى هدف يصل إلى 50 كأسًا. عند تفعيل هذا الخيار، تنتهي اللعبة تلقائيًا عند بلوغه."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Յուրաքանչյուր մակարդակի գավաթների նպատակը մինչև 50 է։ Եթե այս ընտրանքը միացված է, խաղն ինքնաբերաբար ավարտվում է, երբ հասնում ես դրան։"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "প্ৰতিটো লেভেলত সৰ্বাধিক ৫০টা ট্ৰফীৰ লক্ষ্য আছে। এই বিকল্প চালু থাকিলে লক্ষ্য পোৱাৰ লগে লগে খেল নিজে শেষ হ’ব।"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər səviyyənin ən çox 50 kuboklu hədəfi var. Bu seçim aktivdirsə, hədəfə çatanda oyun avtomatik bitir."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Maila bakoitzak gehienez 50 garaikurreko helburua du. Aukera hau piztuta badago, jokoa automatikoki amaituko da helburura iristean."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি লেভেলে সর্বোচ্চ ৫০টি ট্রফির লক্ষ্য আছে। এটি চালু থাকলে লক্ষ্য পূরণ করলেই খেলা নিজে থেকে শেষ হবে।"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အဆင့်တိုင်းမှာ ဆုဖလားပန်းတိုင် အများဆုံး 50 ရှိတယ်။ ဒီရွေးချယ်မှုဖွင့်ထားရင် ပန်းတိုင်ရောက်တာနဲ့ ဂိမ်းအလိုအလျောက်ပြီးမယ်။"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaki nivo ima cilj do 50 trofeja. Ako je ova opcija uključena, igra se automatski završava kad ga dostigneš."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Всяко ниво има цел до 50 трофея. Когато тази опция е включена, играта завършва автоматично, щом я достигнеш."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada nivell té un objectiu de fins a 50 trofeus. Si actives aquesta opció, el joc s’acaba automàticament quan l’assoleixes."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "每关的奖杯目标最高为 50。开启后，达到目标时游戏会自动结束。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver bane har et pokalmål på op til 50. Når denne indstilling er slået til, slutter spillet automatisk, når du når målet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Level hat ein Pokalziel von höchstens 50. Ist diese Option an, endet das Spiel automatisch, sobald du es erreichst."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Igal tasemel on kuni 50 karika eesmärk. Kui see valik on sees, lõpeb mäng eesmärgi täitumisel automaatselt."
          }
        },
        "fo": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvørt stig hevur eitt steypamál upp í 50. Er hetta tendrað, endar spælið sjálvt, tá tú røkkur málinum."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokaisella tasolla on enintään 50 pokaalin tavoite. Kun tämä asetus on päällä, peli päättyy automaattisesti saavuttaessasi tavoitteen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque niveau a un objectif allant jusqu’à 50 trophées. Si cette option est activée, la partie se termine automatiquement quand tu l’atteins."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada nivel ten un obxectivo de ata 50 trofeos. Se activas esta opción, o xogo remata automaticamente ao acadalo."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თითოეულ დონეზე თასების მიზანი მაქსიმუმ 50-ია. თუ ეს პარამეტრი ჩართულია, მიზნის მიღწევისას თამაში ავტომატურად დასრულდება."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάθε επίπεδο έχει στόχο έως 50 τρόπαια. Αν αυτή η επιλογή είναι ενεργή, το παιχνίδι τελειώνει αυτόματα όταν τον φτάσεις."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દરેક લેવલમાં વધુમાં વધુ 50 ટ્રોફીનું લક્ષ્ય છે. આ વિકલ્પ ચાલુ હોય તો લક્ષ્ય મળતાં રમત આપમેળે પૂરી થશે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בכל שלב יש יעד של עד 50 גביעים. כשהאפשרות הזו פועלת, המשחק מסתיים אוטומטית כשמגיעים ליעד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर स्तर का ट्रॉफी लक्ष्य अधिकतम 50 है। यह विकल्प चालू हो तो लक्ष्य पाते ही खेल अपने-आप खत्म हो जाएगा।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden szinten legfeljebb 50 trófea a cél. Ha ezt bekapcsolod, a játék automatikusan véget ér, amikor eléred."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tá sprioc suas le 50 trófaí ag gach leibhéal. Má tá an rogha seo ar siúl, críochnaíonn an cluiche go huathoibríoch nuair a bhaineann tú amach í."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert borð hefur markmið upp á allt að 50 bikara. Þegar þetta er virkt lýkur leiknum sjálfkrafa þegar þú nærð því."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap level memiliki target hingga 50 trofi. Jika opsi ini aktif, permainan otomatis selesai saat target tercapai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni livello ha un obiettivo massimo di 50 trofei. Se questa opzione è attiva, la partita finisce automaticamente quando lo raggiungi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各レベルのトロフィー目標は最大50こです。オンにすると、目標に達したときゲームが自動で終わります。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರತಿ ಹಂತದ ಟ್ರೋಫಿ ಗುರಿ ಗರಿಷ್ಠ 50. ಈ ಆಯ್ಕೆ ಆನ್ ಇದ್ದರೆ, ಗುರಿ ತಲುಪಿದಾಗ ಆಟ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಮುಗಿಯುತ್ತದೆ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әр деңгейде 50-ге дейінгі жүлде мақсаты бар. Бұл баптау қосылса, мақсатқа жеткенде ойын автоматты түрде аяқталады."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កម្រិតនីមួយៗមានគោលដៅពានរហូតដល់ 50។ បើបើកជម្រើសនេះ ហ្គេមនឹងបញ្ចប់ដោយស្វ័យប្រវត្តិពេលអ្នកសម្រេចគោលដៅ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 레벨의 트로피 목표는 최대 50개예요. 이 옵션을 켜면 목표에 도달했을 때 게임이 자동으로 끝나요."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaka razina ima cilj do 50 pehara. Ako je ova opcija uključena, igra automatski završava kad ga dosegneš."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ແຕ່ລະດ່ານມີເປົ້າໝາຍສູງສຸດ 50 ຖ້ວຍ. ຖ້າເປີດຕົວເລືອກນີ້ ເກມຈະຈົບອັດຕະໂນມັດເມື່ອເຈົ້າຮອດເປົ້າໝາຍ."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Katrā līmenī trofeju mērķis ir līdz 50. Ja šī iespēja ir ieslēgta, spēle automātiski beidzas, kad to sasniedz."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiekviename lygyje galima siekti iki 50 trofėjų. Įjungus šią parinktį, pasiekus tikslą žaidimas baigsis automatiškai."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Секое ниво има цел до 50 трофеи. Кога оваа опција е вклучена, играта автоматски завршува штом ќе ја достигнеш."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap tahap ada sasaran hingga 50 trofi. Jika pilihan ini hidup, permainan tamat automatik bila sasaran dicapai."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ ലെവലിലും പരമാവധി 50 ട്രോഫികളുടെ ലക്ഷ്യമുണ്ട്. ഇത് ഓണാക്കിയാൽ ലക്ഷ്യം എത്തിയ ഉടൻ കളി തീരും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक स्तराचे ट्रॉफी ध्येय जास्तीत जास्त 50 आहे. हा पर्याय सुरू असेल, तर ध्येय गाठल्यावर खेळ आपोआप संपेल."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Түвшин бүр 50 хүртэлх цомын зорилготой. Үүнийг асаавал зорилгодоо хүрэхэд тоглоом автоматаар дуусна."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "हरेक लेभलमा बढीमा ५० ट्रफीको लक्ष्य हुन्छ। यो विकल्प चालु भए लक्ष्य पुगेपछि खेल आफैं सकिन्छ।"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert nivå har et trofémål på opptil 50. Når dette valget er på, avsluttes spillet automatisk når du når målet."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На кожному рівні можна здобути до 50 трофеїв. Якщо цю опцію ввімкнено, гра автоматично завершиться, коли ти досягнеш цілі."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପ୍ରତ୍ୟେକ ଲେଭେଲ୍‌ରେ ସର୍ବାଧିକ 50 ଟ୍ରଫିର ଲକ୍ଷ୍ୟ ରହେ। ଏହି ବିକଳ୍ପ ଚାଲୁ ଥିଲେ, ଲକ୍ଷ୍ୟ ପୂରଣ କରିବାମାତ୍ରେ ଖେଳ ନିଜେ ଶେଷ ହେବ।"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "ھەر بىر دەرىجىنىڭ ئەڭ كۆپ 50 لوڭقىلىق نىشانى بار. بۇ تاللانما ئوچۇق بولسا، نىشانغا يەتكەندە ئويۇن ئاپتوماتىك ئاخىرلىشىدۇ."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Har bir bosqichda 50 tagacha sovrin maqsadi bor. Bu sozlama yoqilsa, maqsadga yetganingda o‘yin avtomatik tugaydi."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر مرحله تا ۵۰ جام هدف دارد. اگر این گزینه روشن باشد، وقتی به هدف برسی بازی خودکار تمام می‌شود."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy poziom ma cel do 50 pucharów. Gdy ta opcja jest włączona, gra kończy się automatycznie po jego osiągnięciu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada nível tem uma meta de até 50 troféus. Com esta opção ligada, o jogo termina automaticamente quando a atinges."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਰ ਲੈਵਲ ਵਿੱਚ ਵੱਧ ਤੋਂ ਵੱਧ 50 ਟ੍ਰਾਫੀਆਂ ਦਾ ਟੀਚਾ ਹੈ। ਇਹ ਚੋਣ ਚਾਲੂ ਹੋਵੇ ਤਾਂ ਟੀਚਾ ਪੂਰਾ ਹੁੰਦੇ ਹੀ ਖੇਡ ਆਪਣੇ ਆਪ ਮੁੱਕ ਜਾਂਦੀ ਹੈ।"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare nivel are un obiectiv de până la 50 de trofee. Dacă această opțiune este activă, jocul se încheie automat când îl atingi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На каждом уровне можно получить до 50 трофеев. Если включить эту настройку, игра завершится автоматически, когда цель будет достигнута."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaki nivo ima cilj do 50 trofeja. Kad je ova opcija uključena, igra se završava čim ga dostigneš."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "එක් එක් මට්ටමේ කුසලාන ඉලක්කය 50 දක්වා වේ. මෙය ක්‍රියාත්මක නම් ඉලක්කයට ළඟා වූ විට ක්‍රීඩාව ස්වයංක්‍රීයව අවසන් වේ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá úroveň má cieľ najviac 50 trofejí. Ak je táto možnosť zapnutá, hra sa po jeho dosiahnutí automaticky skončí."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsaka stopnja ima cilj do 50 pokalov. Ko je ta možnost vklopljena, se igra samodejno konča, ko ga dosežeš."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada nivel tiene un objetivo de hasta 50 trofeos. Si activas esta opción, el juego termina automáticamente al alcanzarlo."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kila kiwango kina lengo la hadi vikombe 50. Chaguo hili likiwashwa, mchezo huisha moja kwa moja unapolifikia."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு நிலைக்கும் அதிகபட்சம் 50 கோப்பைகள் இலக்கு. இது இயக்கப்பட்டால், இலக்கை அடைந்ததும் விளையாட்டு தானாக முடியும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి లెవల్‌లో గరిష్ఠంగా 50 ట్రోఫీల లక్ష్యం ఉంటుంది. ఈ ఎంపిక ఆన్‌లో ఉంటే, లక్ష్యాన్ని చేరగానే ఆట ముగుస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แต่ละด่านมีเป้าหมายสูงสุด 50 ถ้วย เมื่อเปิดตัวเลือกนี้ เกมจะจบเองเมื่อถึงเป้าหมาย"
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "རིམ་པ་རེར་བྱ་དགའི་དམིགས་ཡུལ་50 བར་ཡོད། འདེམས་སྒྲིག་འདི་ཁ་ཕྱེ་ན། དམིགས་ཡུལ་སླེབས་མ་ཐག་རྩེད་མོ་རང་འགུལ་གྱིས་མཇུག་སྒྲིལ།"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá úroveň má cíl až 50 trofejí. Když je tato možnost zapnutá, hra po jeho dosažení automaticky skončí."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her seviyenin en fazla 50 kupalık bir hedefi vardır. Bu seçenek açıksa hedefe ulaşınca oyun otomatik olarak biter."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر لیول میں زیادہ سے زیادہ 50 ٹرافیوں کا ہدف ہے۔ یہ اختیار آن ہو تو ہدف پورا ہوتے ہی کھیل خود ختم ہو جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi cấp có mục tiêu tối đa 50 cúp. Khi bật tùy chọn này, trò chơi tự kết thúc khi bạn đạt mục tiêu."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Mae gan bob lefel nod o hyd at 50 tlws. Os yw'r dewis hwn ymlaen, bydd y gêm yn gorffen yn awtomatig pan gyrhaeddi di'r nod."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "На кожным узроўні можна сабраць да 50 трафеяў. Калі гэтая налада ўключана, гульня завершыцца аўтаматычна, калі ты дасягнеш мэты."
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ileveli ngayinye inomgomo wezindebe ofinyelela ku-50. Uma le nketho ivuliwe, umdlalo uphela ngokuzenzakalela lapho uwufinyelela."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje nivå har ett pokalmål på högst 50. När detta är på avslutas spelet automatiskt när du når målet."
          }
        }
      }
    },
