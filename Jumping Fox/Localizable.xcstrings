    "options.unlimitedLives.info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You always start with 3 lives. The game will finish when you have no lives left. Turn this option on to keep playing and practice after your lives are gone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je begint altijd met 3 levens. Het spel wordt beëindigd als je geen levens meer hebt. Zet deze optie aan om door te spelen en te oefenen nadat je levens op zijn."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jy begin altyd met 3 lewens. Die spel eindig wanneer jy geen lewens oor het nie. Skakel dié opsie aan om aan te hou speel en oefen nadat jou lewens op is."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Fillon gjithmonë me 3 jetë. Loja mbaron kur nuk të mbetet asnjë jetë. Aktivizoje këtë opsion për të vazhduar të luash e të ushtrohesh pasi të mbarojnë jetët."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ሁልጊዜ በ3 ሕይወቶች ትጀምራለህ። ሕይወቶችህ ሲያልቁ ጨዋታው ይጠናቀቃል። ሕይወቶችህ ካለቁ በኋላም ለመጫወትና ለመለማመድ ይህን አማራጭ አብራ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبدأ دائمًا بـ3 حيوات. تنتهي اللعبة عند نفادها. فعّل هذا الخيار لمتابعة اللعب والتمرّن بعد نفاد حيواتك."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դու միշտ սկսում ես 3 կյանքով։ Երբ կյանքերդ վերջանան, խաղը կավարտվի։ Միացրու այս ընտրանքը՝ դրանից հետո էլ խաղալու և փորձելու համար։"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "তুমি সদায় ৩টা জীৱনেৰে আৰম্ভ কৰা। জীৱন শেষ হ’লে খেল শেষ হ’ব। জীৱন শেষৰ পিছতো খেলি অভ্যাস কৰিবলৈ এই বিকল্প চালু কৰা।"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Həmişə 3 canla başlayırsan. Canların bitəndə oyun başa çatır. Canların bitəndən sonra da oynayıb məşq etmək üçün bu seçimi aktiv et."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Beti 3 bizitzarekin hasten zara. Bizitzarik gabe geratzean, jokoa amaituko da. Piztu aukera hau bizitzak amaitu ondoren jolasten eta praktikatzen jarraitzeko."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তুমি সব সময় ৩টি জীবন নিয়ে শুরু করবে। জীবন শেষ হলে খেলা শেষ হবে। জীবন শেষের পরও খেলতে ও অনুশীলন করতে এটি চালু করো।"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အမြဲ အသက် ၃ ခုနဲ့ စမယ်။ အသက်ကုန်ရင် ဂိမ်းပြီးမယ်။ အသက်ကုန်ပြီးနောက်လည်း ဆက်ကစားလေ့ကျင့်ဖို့ ဒီရွေးချယ်မှုကို ဖွင့်ပါ။"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvijek počinješ s 3 života. Igra završava kad izgubiš sve živote. Uključi ovu opciju da nastaviš igrati i vježbati nakon toga."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Винаги започваш с 3 живота. Играта свършва, когато останеш без животи. Включи тази опция, за да продължиш да играеш и упражняваш след това."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre comences amb 3 vides. El joc s’acaba quan et quedes sense vides. Activa aquesta opció per continuar jugant i practicant després de perdre-les."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你每次都从 3 条生命开始。生命用完时游戏结束。开启此选项后，生命用完仍可继续练习。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du starter altid med 3 liv. Spillet slutter, når du ikke har flere liv. Slå dette til for at fortsætte med at spille og øve, når dine liv er brugt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du startest immer mit 3 Leben. Das Spiel endet, wenn du keine Leben mehr hast. Schalte diese Option ein, um danach weiterzuspielen und zu üben."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Alustad alati 3 eluga. Mäng lõpeb, kui elud saavad otsa. Lülita see sisse, et pärast elude lõppemist edasi mängida ja harjutada."
          }
        },
        "fo": {
          "stringUnit": {
            "state": "translated",
            "value": "Tú byrjar altíð við 3 lívum. Spælið endar, tá tú einki lív hevur eftir. Tendr hetta fyri at halda fram at spæla og venja, tá lívini eru uppi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloitat aina kolmella elämällä. Peli päättyy, kun elämäsi loppuvat. Ota tämä käyttöön, jotta voit jatkaa pelaamista ja harjoittelua sen jälkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu commences toujours avec 3 vies. La partie se termine quand tu n’as plus de vies. Active cette option pour continuer à jouer et t’entraîner après les avoir perdues."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre comezas con 3 vidas. O xogo remata cando quedas sen vidas. Activa esta opción para seguir xogando e practicando despois."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ყოველთვის 3 სიცოცხლით იწყებ. როცა სიცოცხლე აღარ დაგრჩება, თამაში დასრულდება. ჩართე ეს პარამეტრი, რომ სიცოცხლეების ამოწურვის შემდეგაც გააგრძელო თამაში და ვარჯიში."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκινάς πάντα με 3 ζωές. Το παιχνίδι τελειώνει όταν δεν σου μείνει καμία. Ενεργοποίησε αυτή την επιλογή για να συνεχίσεις να παίζεις και να εξασκείσαι μετά."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે હંમેશા 3 જીવનથી શરૂ કરો છો. જીવન પૂરાં થતાં રમત પૂરી થશે. જીવન પૂરાં થયા પછી પણ રમવા અને અભ્યાસ કરવા આ વિકલ્પ ચાલુ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תמיד מתחילים עם 3 חיים. המשחק מסתיים כשלא נשארים חיים. הפעילו אפשרות זו כדי להמשיך לשחק ולהתאמן גם אחרי שהחיים נגמרים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम हमेशा 3 जीवन से शुरू करते हो। जीवन खत्म होते ही खेल खत्म होगा। जीवन खत्म होने के बाद भी खेलने और अभ्यास करने के लिए यह विकल्प चालू करें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindig 3 élettel kezdesz. A játék véget ér, ha elfogynak az életeid. Kapcsold be, hogy utána is játszhass és gyakorolhass."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tosaíonn tú le 3 bheatha i gcónaí. Críochnaíonn an cluiche nuair nach mbíonn aon bheatha fágtha agat. Cuir an rogha seo ar siúl chun leanúint ag imirt agus ag cleachtadh tar éis do bheathaí a bheith caillte."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Þú byrjar alltaf með 3 líf. Leiknum lýkur þegar lífin eru búin. Kveiktu á þessu til að halda áfram að spila og æfa eftir það."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu selalu mulai dengan 3 nyawa. Permainan selesai saat nyawamu habis. Aktifkan opsi ini agar tetap bisa bermain dan berlatih setelah nyawamu habis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizi sempre con 3 vite. La partita finisce quando non hai più vite. Attiva questa opzione per continuare a giocare e allenarti anche dopo averle finite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつもライフ3こで始まります。ライフがなくなるとゲームは終わります。オンにすると、ライフがなくなったあとも遊んでれんしゅうできます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀನು ಯಾವಾಗಲೂ 3 ಜೀವಗಳಿಂದ ಆರಂಭಿಸುತ್ತೀಯ. ಜೀವಗಳು ಮುಗಿದಾಗ ಆಟ ಮುಗಿಯುತ್ತದೆ. ಜೀವಗಳು ಮುಗಿದ ಮೇಲೂ ಆಡಲು ಮತ್ತು ಅಭ್ಯಾಸ ಮಾಡಲು ಈ ಆಯ್ಕೆಯನ್ನು ಆನ್ ಮಾಡು."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Әрдайым 3 жанмен бастайсың. Жандарың біткенде ойын аяқталады. Жандарың біткеннен кейін де ойнап, жаттығу үшін осы баптауды қос."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្នកតែងតែចាប់ផ្តើមដោយមាន 3 ជីវិត។ ហ្គេមនឹងបញ្ចប់ពេលអ្នកអស់ជីវិត។ បើកជម្រើសនេះ ដើម្បីបន្តលេង និងហាត់ក្រោយពេលជីវិតអស់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항상 목숨 3개로 시작해요. 목숨을 모두 잃으면 게임이 끝나요. 이 옵션을 켜면 목숨이 없어도 계속 연습할 수 있어요."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvijek počinješ s 3 života. Igra završava kad ih izgubiš. Uključi ovu opciju za nastavak igre i vježbanje bez života."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ເຈົ້າເລີ່ມດ້ວຍ 3 ຊີວິດສະເໝີ. ເກມຈະຈົບເມື່ອຊີວິດໝົດ. ເປີດຕົວເລືອກນີ້ເພື່ອຫຼິ້ນ ແລະ ຝຶກຕໍ່ຫຼັງຈາກຊີວິດໝົດ."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu vienmēr sāc ar 3 dzīvībām. Spēle beidzas, kad dzīvību vairs nav. Ieslēdz šo iespēju, lai pēc tam turpinātu spēlēt un trenēties."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Visada pradedi su 3 gyvybėmis. Kai jos baigiasi, žaidimas baigiamas. Įjunk šią parinktį, kad galėtum toliau žaisti ir mokytis."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Секогаш почнуваш со 3 животи. Играта завршува кога ќе останеш без животи. Вклучи ја оваа опција за да продолжиш да играш и вежбаш и потоа."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu sentiasa bermula dengan 3 nyawa. Permainan tamat bila nyawa habis. Hidupkan pilihan ini untuk terus bermain dan berlatih selepas nyawa habis."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നീ എപ്പോഴും 3 ജീവനുകളോടെ തുടങ്ങും. ജീവനുകൾ തീർന്നാൽ കളി തീരും. അതിന് ശേഷവും കളിച്ച് പരിശീലിക്കാൻ ഇത് ഓണാക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तू नेहमी 3 जीवांनी सुरू करतोस. जीव संपले की खेळ संपतो. जीव संपल्यानंतरही खेळत आणि सराव करत राहण्यासाठी हा पर्याय सुरू कर."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Чи үргэлж 3 амьтай эхэлнэ. Амь дуусахад тоглоом дуусна. Амь дууссан ч үргэлжлүүлэн тоглож, давтахын тулд үүнийг асаа."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तिमी सधैं ३ जीवनबाट सुरु गर्छौ। जीवन सकिएपछि खेल सकिन्छ। जीवन सकिएपछि पनि खेल्दै अभ्यास गर्न यो विकल्प चालु गर।"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Du starter alltid med 3 liv. Spillet avsluttes når du er tom for liv. Slå på dette valget for å fortsette å spille og øve etterpå."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ти завжди починаєш із 3 життями. Гра завершиться, коли життя закінчаться. Увімкни цю опцію, щоб далі грати й тренуватися без життів."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ତୁମେ ସବୁବେଳେ 3ଟି ଜୀବନରୁ ଆରମ୍ଭ କର। ସବୁ ଜୀବନ ଶେଷ ହେଲେ ଖେଳ ଶେଷ ହେବ। ଜୀବନ ଶେଷ ପରେ ମଧ୍ୟ ଖେଳିବା ଓ ଅଭ୍ୟାସ କରିବାକୁ ଏହି ବିକଳ୍ପ ଚାଲୁ କର।"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "ھەمىشە 3 جان بىلەن باشلايسەن. جانلىرىڭ تۈگىسە ئويۇن ئاخىرلىشىدۇ. جان تۈگىگەندىن كېيىنمۇ ئويناش ۋە مەشىق قىلىش ئۈچۈن بۇ تاللانمىنى ئاچ."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Har doim 3 ta jon bilan boshlaysan. Jonlaring tugasa, o‘yin yakunlanadi. Jonlaring tugagach ham o‘ynash va mashq qilish uchun bu sozlamani yoq."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همیشه با ۳ جان شروع می‌کنی. وقتی جان‌ها تمام شوند، بازی پایان می‌یابد. این گزینه را روشن کن تا بعد از تمام شدن جان‌ها هم بازی و تمرین کنی."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawsze zaczynasz z 3 życiami. Gra kończy się, gdy je stracisz. Włącz tę opcję, aby dalej grać i ćwiczyć bez żyć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Começas sempre com 3 vidas. O jogo termina quando ficares sem vidas. Liga esta opção para continuares a jogar e a praticar depois de as vidas acabarem."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਹਮੇਸ਼ਾ 3 ਜਾਨਾਂ ਨਾਲ ਸ਼ੁਰੂ ਕਰਦੇ ਹੋ। ਜਾਨਾਂ ਮੁੱਕਣ 'ਤੇ ਖੇਡ ਖਤਮ ਹੋ ਜਾਂਦੀ ਹੈ। ਬਾਅਦ ਵਿੱਚ ਵੀ ਖੇਡਣ ਅਤੇ ਅਭਿਆਸ ਲਈ ਇਹ ਚੋਣ ਚਾਲੂ ਕਰੋ।"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Începi mereu cu 3 vieți. Jocul se încheie când nu mai ai vieți. Activează această opțiune ca să continui să te joci și să exersezi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты всегда начинаешь с 3 жизнями. Когда жизни закончатся, игра завершится. Включи эту настройку, чтобы продолжить играть и тренироваться без жизней."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uvek počinješ sa 3 života. Igra se završava kad izgubiš sve živote. Uključi ovu opciju da nastaviš da igraš i vežbaš i tada."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබ හැමවිටම ජීවිත 3කින් පටන් ගනී. ජීවිත ඉවර වූ විට ක්‍රීඩාව අවසන් වේ. ජීවිත ඉවර වූ පසුත් ක්‍රීඩා කර පුහුණු වීමට මෙය ක්‍රියාත්මක කරන්න."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vždy začínaš s 3 životmi. Hra sa skončí, keď už nemáš žiadny život. Zapni túto možnosť, aby si mohol hrať a trénovať ďalej aj bez životov."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedno začneš s 3 življenji. Igra se konča, ko ti jih zmanjka. Vklopi to možnost, da lahko igraš in vadiš tudi brez življenj."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siempre empiezas con 3 vidas. El juego termina cuando te quedas sin vidas. Activa esta opción para seguir jugando y practicando después."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Daima unaanza na maisha 3. Mchezo huisha maisha yakikwisha. Washa chaguo hili ili kuendelea kucheza na kufanya mazoezi baada ya maisha kuisha."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீ எப்போதும் 3 உயிர்களுடன் தொடங்குவாய். உயிர்கள் தீர்ந்ததும் விளையாட்டு முடியும். உயிர்கள் தீர்ந்த பிறகும் தொடர்ந்து விளையாடிப் பயிற்சி செய்ய இதை இயக்கு."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నువ్వు ఎప్పుడూ 3 లైఫ్‌లతో మొదలుపెడతావు. లైఫ్‌లు అయిపోతే ఆట ముగుస్తుంది. లైఫ్‌లు అయిపోయాక కూడా ఆడి సాధన చేయడానికి దీన్ని ఆన్ చేయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มด้วย 3 ชีวิตเสมอ เกมจะจบเมื่อชีวิตหมด เปิดตัวเลือกนี้เพื่อเล่นและฝึกต่อหลังชีวิตหมด"
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "ཁྱེད་ལ་རྟག་ཏུ་སྲོག་3 ཡོད། སྲོག་ཚར་ན་རྩེད་མོ་མཇུག་སྒྲིལ། སྲོག་ཚར་རྗེས་ཀྱང་མུ་མཐུད་རྩེ་ཞིང་སྦྱོང་བར་འདེམས་སྒྲིག་འདི་ཁ་ཕྱེ།"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vždy začínáš se 3 životy. Hra skončí, když ti žádný nezbude. Zapni tuto možnost, abys mohl pokračovat a trénovat i bez životů."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her zaman 3 canla başlarsın. Canların bitince oyun sona erer. Canların bittikten sonra oynamaya ve çalışmaya devam etmek için bu seçeneği aç."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ ہمیشہ 3 جانوں سے شروع کرتے ہیں۔ جانیں ختم ہوں تو کھیل ختم ہو جاتا ہے۔ جانیں ختم ہونے کے بعد بھی کھیلنے اور مشق کے لیے یہ اختیار آن کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn luôn bắt đầu với 3 mạng. Trò chơi kết thúc khi bạn hết mạng. Bật tùy chọn này để tiếp tục chơi và luyện tập sau khi hết mạng."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Rwyt ti bob amser yn dechrau gyda 3 bywyd. Bydd y gêm yn gorffen pan nad oes bywydau ar ôl. Tro'r dewis hwn ymlaen i barhau i chwarae ac ymarfer ar ôl i'r bywydau ddod i ben."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты заўсёды пачынаеш з 3 жыццямі. Гульня завершыцца, калі жыцці скончацца. Уключы гэтую наладу, каб працягваць гуляць і трэніравацца без жыццяў."
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Njalo uqala ngezimpilo ezi-3. Umdlalo uphela uma zingasekho izimpilo. Vula le nketho ukuze uqhubeke udlale futhi uzijwayeze ngemva kokuphela kwezimpilo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du börjar alltid med 3 liv. Spelet slutar när dina liv är slut. Slå på detta för att fortsätta spela och öva när liven är slut."
          }
        }
      }
    },
