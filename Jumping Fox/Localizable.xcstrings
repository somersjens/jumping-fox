    "settings.livesInfo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With three lives the game ends after your last heart. In unlimited mode trophies only count while you still have lives; after that you can keep playing."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met drie levens eindigt het spel na je laatste hartje. In oneindige modus tellen trofeeën alleen mee zolang je nog levens hebt; daarna kun je wel doorspelen."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Met drie lewens eindig die spel ná jou laaste hartjie. In onbeperkte modus tel trofeë net terwyl jy nog lewens het; daarna kan jy aanhou speel."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Me tre jetë, loja mbaron pas zemrës së fundit. Në modalitetin pa kufi, trofetë numërohen vetëm sa ke jetë; më pas mund të vazhdosh të luash."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "በሦስት ሕይወቶች ሁነታ ከመጨረሻው ልብህ በኋላ ጨዋታው ያበቃል። ባልተገደበ ሁነታ ዋንጫዎች የሚቆጠሩት ሕይወት እስካለህ ብቻ ነው፤ ከዚያም መጫወትህን መቀጠል ትችላለህ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مع ثلاث حيوات، تنتهي اللعبة بعد آخر قلب. في الوضع غير المحدود، تُحسب الكؤوس ما دامت لديك حيوات؛ وبعدها يمكنك متابعة اللعب."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Երեք կյանքով խաղն ավարտվում է վերջին սրտից հետո։ Անսահման ռեժիմում գավաթները հաշվվում են միայն քանի դեռ կյանք ունես, իսկ հետո կարող ես շարունակել խաղալ։"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "৩টা জীৱনত শেষ হৃদয়ৰ পিছত খেল শেষ হয়। সীমাহীন মোডত জীৱন থকালৈকে ট্ৰফী গণনা হয়; তাৰ পিছতো খেলি থাকিব পাৰা।"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Üç can rejimində son ürəyindən sonra oyun bitir. Sonsuz rejimdə kuboklar yalnız canın olduğu müddətdə sayılır; sonra oynamağa davam edə bilərsən."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiru bizitzarekin, jokoa azken bihotza galtzean amaitzen da. Modu mugagabean, garaikurrek bizitzak dituzun bitartean bakarrik balio dute; gero jolasten jarrai dezakezu."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তিনটি জীবনে শেষ হৃদয় হারালে খেলা শেষ। অসীম মোডে জীবন থাকা পর্যন্তই ট্রফি গোনা হয়; তারপরও খেলতে পারবে।"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အသက်သုံးခုမုဒ်မှာ နောက်ဆုံးနှလုံးကုန်ရင် ဂိမ်းပြီးမယ်။ အကန့်အသတ်မရှိမုဒ်မှာ အသက်ရှိနေသေးချိန်ပဲ ဆုဖလားရေတွက်မယ်၊ ပြီးရင်တော့ ဆက်ကစားနိုင်တယ်။"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "S tri života igra završava nakon posljednjeg srca. U neograničenom načinu trofeji se broje samo dok imaš života; poslije možeš nastaviti igrati."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "С три живота играта свършва след последното ти сърце. В безкраен режим трофеите се броят само докато имаш животи; след това можеш да продължиш да играеш."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Amb tres vides, el joc s’acaba després de l’últim cor. En el mode il·limitat, els trofeus només compten mentre encara tens vides; després pots continuar jugant."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "使用三条生命时，最后一颗爱心用完后游戏结束。无限模式中，只有还有生命时奖杯才会计数；之后仍可继续游戏。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Med tre liv slutter spillet efter dit sidste hjerte. I ubegrænset tilstand tæller pokaler kun, mens du har liv. Derefter kan du fortsætte med at spille."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit drei Leben endet das Spiel nach deinem letzten Herz. Im unbegrenzten Modus zählen Pokale nur, solange du noch Leben hast. Danach kannst du weiterspielen."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolme eluga lõpeb mäng pärast viimast südant. Piiramatus režiimis loetakse karikaid ainult seni, kuni sul on elusid; pärast saad edasi mängida."
          }
        },
        "fo": {
          "stringUnit": {
            "state": "translated",
            "value": "Við trimum lívum endar spælið eftir títt seinasta hjarta. Í óavmarkaðari støðu telja steyp bara, meðan tú enn hevur lív; síðan kanst tú halda fram at spæla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolmella elämällä peli päättyy viimeisen sydämesi jälkeen. Rajattomassa tilassa pokaalit lasketaan vain niin kauan kuin elämiä on jäljellä; sen jälkeen voit jatkaa pelaamista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec trois vies, la partie se termine après ton dernier cœur. En mode illimité, les trophées ne comptent que tant qu’il te reste des vies ; ensuite, tu peux continuer à jouer."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Con tres vidas, o xogo remata tras perder o último corazón. No modo sen límite, os trofeos só contan mentres che queden vidas; despois podes seguir xogando."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სამი სიცოცხლის რეჟიმში თამაში ბოლო გულის დაკარგვის შემდეგ მთავრდება. უსასრულო რეჟიმში თასები მხოლოდ სიცოცხლეების დარჩენამდე ითვლება; მერე თამაშის გაგრძელება მაინც შეგიძლია."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με τρεις ζωές, το παιχνίδι τελειώνει μετά την τελευταία καρδιά. Στην απεριόριστη λειτουργία, τα τρόπαια μετρούν μόνο όσο έχεις ζωές. Μετά μπορείς να συνεχίσεις."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ત્રણ જીવનમાં છેલ્લું હૃદય ગયા પછી રમત પૂરી થાય છે. અમર્યાદિત મોડમાં જીવન હોય ત્યાં સુધી જ ટ્રોફી ગણાય; પછી પણ તમે રમતા રહી શકો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עם שלושה חיים המשחק מסתיים אחרי הלב האחרון. במצב ללא הגבלה, גביעים נספרים רק כל עוד נשארו חיים; לאחר מכן אפשר להמשיך לשחק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तीन जीवन में आखिरी दिल के बाद खेल खत्म हो जाता है। असीमित मोड में ट्रॉफियाँ केवल जीवन रहते तक गिनी जाती हैं; फिर भी खेल सकते हो।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Három élettel a játék az utolsó szíved után véget ér. Korlátlan módban a trófeák csak addig számítanak, amíg van életed; utána tovább játszhatsz."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Le trí bheatha, críochnaíonn an cluiche tar éis do chroí deiridh. Sa mhód gan teorainn, ní áirítear trófaithe ach fad atá beathaí agat; ina dhiaidh sin is féidir leat leanúint ag imirt."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Með þremur lífum lýkur leiknum eftir síðasta hjartað. Í ótakmarkaðri stillingu teljast bikarar aðeins meðan þú átt líf; svo máttu halda áfram."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan tiga nyawa, permainan berakhir setelah hati terakhirmu habis. Dalam mode tak terbatas, trofi hanya dihitung selama kamu masih punya nyawa; setelah itu kamu tetap bisa bermain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con tre vite, la partita finisce dopo l’ultimo cuore. In modalità illimitata, i trofei contano solo finché hai ancora vite; dopo puoi continuare a giocare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライフ3こでは、最後のハートがなくなるとゲーム終了です。むげんモードでは、ライフがある間だけトロフィーが増え、そのあとも遊びつづけられます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮೂರು ಜೀವಗಳಲ್ಲಿ ಕೊನೆಯ ಹೃದಯ ಕಳೆದುಕೊಂಡಾಗ ಆಟ ಮುಗಿಯುತ್ತದೆ. ಅಮಿತ ಮೋಡ್‌ನಲ್ಲಿ ಜೀವಗಳು ಇರುವವರೆಗೆ ಮಾತ್ರ ಟ್ರೋಫಿಗಳು ಲೆಕ್ಕಕ್ಕೆ ಸೇರುತ್ತವೆ; ನಂತರವೂ ಆಡಬಹುದು."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Үш жан режимінде соңғы жүрегің біткенде ойын аяқталады. Шексіз режимде жүлделер жандарың бар кезде ғана есептеледі; кейін ойнай беруге болады."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ជាមួយ 3 ជីវិត ហ្គេមបញ្ចប់ក្រោយបេះដូងចុងក្រោយ។ ក្នុងរបៀបគ្មានកំណត់ ពានរាប់តែពេលអ្នកនៅមានជីវិត; បន្ទាប់ពីនោះ អ្នកនៅតែអាចបន្តលេងបាន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목숨이 3개면 마지막 하트를 잃은 뒤 게임이 끝나요. 무제한 모드에서는 목숨이 남아 있을 때만 트로피가 계산되고, 그 뒤에도 계속 놀 수 있어요."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "S tri života igra završava nakon zadnjeg srca. U neograničenom načinu pehari se broje samo dok imaš života; nakon toga možeš nastaviti igrati."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ດ້ວຍ 3 ຊີວິດ ເກມຈະຈົບຫຼັງຈາກຫົວໃຈດວງສຸດທ້າຍ. ໃນໂໝດບໍ່ຈຳກັດ ຖ້ວຍຈະນັບສະເພາະຕອນທີ່ຍັງມີຊີວິດ; ຫຼັງຈາກນັ້ນຍັງຫຼິ້ນຕໍ່ໄດ້."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ar trim dzīvībām spēle beidzas pēc pēdējās sirsniņas. Neierobežotajā režīmā trofejas skaita tikai, kamēr tev vēl ir dzīvības; pēc tam vari turpināt spēlēt."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Su trimis gyvybėmis žaidimas baigiasi praradus paskutinę širdelę. Neribotu režimu trofėjai skaičiuojami tik kol turi gyvybių, o vėliau gali žaisti toliau."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Со три животи, играта завршува по последното срце. Во неограничен режим, трофеите се бројат само додека имаш животи; потоа можеш да продолжиш да играш."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan tiga nyawa, permainan tamat selepas hati terakhir. Dalam mod tanpa had, trofi hanya dikira selagi kamu masih ada nyawa; selepas itu kamu boleh terus bermain."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മൂന്ന് ജീവനുകളുള്ളപ്പോൾ അവസാന ഹൃദയം പോയാൽ കളി തീരും. പരിധിയില്ലാത്ത മോഡിൽ ജീവനുകൾ ഉള്ളപ്പോൾ മാത്രം ട്രോഫികൾ എണ്ണും; ശേഷം കളി തുടരാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तीन जीवांत शेवटचे हृदय गेल्यावर खेळ संपतो. अमर्याद मोडमध्ये जीव असेपर्यंतच ट्रॉफी मोजल्या जातात; त्यानंतरही तू खेळू शकतोस."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "3 амьтай үед сүүлийн зүрхээ алдмагц тоглоом дуусна. Хязгааргүй горимд амьтай байх үед л цом тооцогдоно; дараа нь үргэлжлүүлэн тоглож болно."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तीन जीवनमा अन्तिम मुटु सकिएपछि खेल सकिन्छ। असीमित मोडमा जीवन रहुन्जेल मात्र ट्रफी गनिन्छ; त्यसपछि खेलिरहन सकिन्छ।"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Med tre liv slutter spillet etter det siste hjertet. Med ubegrensede liv teller trofeer bare mens du fortsatt har liv. Deretter kan du fortsette å spille."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З трьома життями гра закінчується після останнього серця. У безлімітному режимі трофеї рахуються, лише поки є життя; потім можна грати далі."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ତିନିଟି ଜୀବନ ଥିଲେ ଶେଷ ହୃଦୟ ହରାଇବା ପରେ ଖେଳ ଶେଷ ହୁଏ। ଅସୀମ ମୋଡ୍‌ରେ ଜୀବନ ଥିବା ପର୍ଯ୍ୟନ୍ତ ମାତ୍ର ଟ୍ରଫି ଗଣାଯାଏ; ତାପରେ ମଧ୍ୟ ତୁମେ ଖେଳିପାରିବ।"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "ئۈچ جان ھالىتىدە ئاخىرقى يۈرىكىڭ تۈگىگەندە ئويۇن ئاخىرلىشىدۇ. چەكسىز ھالەتتە جان بار چاغدىلا لوڭقىلار ھېسابلىنىدۇ؛ كېيىنمۇ ئويناشنى داۋاملاشتۇرالايسەن."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Uchta jon rejimida oxirgi yuraging tugagach o‘yin yakunlanadi. Cheksiz rejimda sovrinlar faqat jonlaring bor paytda sanaladi; keyin ham o‘ynashda davom etishing mumkin."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با سه جان، بازی پس از آخرین قلب تمام می‌شود. در حالت نامحدود، جام‌ها فقط تا وقتی جان داری حساب می‌شوند؛ بعد از آن می‌توانی به بازی ادامه بدهی."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy trzech życiach gra kończy się po ostatnim sercu. W trybie bez limitu puchary liczą się tylko, gdy masz życia; potem możesz grać dalej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com três vidas, o jogo termina depois do último coração. No modo ilimitado, os troféus só contam enquanto ainda tens vidas; depois, podes continuar a jogar."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "3 ਜਾਨਾਂ ਨਾਲ ਆਖਰੀ ਦਿਲ ਤੋਂ ਬਾਅਦ ਖੇਡ ਮੁੱਕਦੀ ਹੈ। ਬੇਅੰਤ ਮੋਡ ਵਿੱਚ ਟ੍ਰਾਫੀਆਂ ਸਿਰਫ਼ ਜਾਨਾਂ ਰਹਿਣ ਤੱਕ ਗਿਣੀਆਂ ਜਾਂਦੀਆਂ ਹਨ; ਫਿਰ ਵੀ ਤੁਸੀਂ ਖੇਡ ਸਕਦੇ ਹੋ।"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cu trei vieți, jocul se termină după ultima inimă. În modul nelimitat, trofeele contează doar cât timp mai ai vieți; apoi poți continua să te joci."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С тремя жизнями игра заканчивается после последнего сердечка. В бесконечном режиме трофеи считаются, пока есть жизни; затем можно продолжать играть."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa tri života igra se završava posle poslednjeg srca. U neograničenom režimu trofeji se računaju samo dok imaš živote; posle možeš da nastaviš da igraš."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ජීවිත තුනක් තිබේ නම් අවසාන හදවතෙන් පසු ක්‍රීඩාව අවසන් වේ. අසීමිත මාදිලියේ ජීවිත තිබෙන තුරු පමණක් කුසලාන ගණන් වේ; ඉන්පසුත් ක්‍රීඩා කළ හැක."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "S tromi životmi sa hra skončí po poslednom srdiečku. V neobmedzenom režime sa trofeje počítajú iba dovtedy, kým máš životy; potom môžeš hrať ďalej."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "S tremi življenji se igra konča po zadnjem srčku. V neomejenem načinu pokali štejejo le, dokler imaš življenja; nato lahko še naprej igraš."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con tres vidas, el juego termina tras tu último corazón. En el modo ilimitado, los trofeos solo cuentan mientras te queden vidas; después puedes seguir jugando."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukiwa na maisha matatu, mchezo huisha baada ya moyo wako wa mwisho. Katika hali isiyo na kikomo, vikombe huhesabiwa ukiwa bado na maisha; baada ya hapo unaweza kuendelea kucheza."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மூன்று உயிர்கள் முறையில் கடைசி இதயம் போனதும் விளையாட்டு முடியும். வரம்பில்லா முறையில் உயிர்கள் இருக்கும் வரை மட்டுமே கோப்பைகள் கணக்காகும்; பிறகும் தொடர்ந்து விளையாடலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మూడు లైఫ్‌లతో చివరి గుండె పోగానే ఆట ముగుస్తుంది. అపరిమిత మోడ్‌లో లైఫ్‌లు ఉన్నంతవరకే ట్రోఫీలు లెక్కలోకి వస్తాయి; తర్వాత కూడా ఆడవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อมีสามชีวิต เกมจะจบหลังเสียหัวใจดวงสุดท้าย ในโหมดไม่จำกัด ถ้วยรางวัลจะนับเฉพาะตอนที่ยังมีชีวิต หลังจากนั้นยังเล่นต่อได้"
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "སྲོག་གསུམ་ཡོད་ན་སྙིང་མཐའ་མ་ཤོར་རྗེས་རྩེད་མོ་ཚར། ཚད་མེད་རྣམ་པའི་ནང་སྲོག་ཡོད་རིང་ཁོ་ན་བྱ་དགའ་བརྩི། དེ་རྗེས་ཀྱང་མུ་མཐུད་རྩེ་ཆོག"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Se třemi životy hra skončí po ztrátě posledního srdce. V neomezeném režimu se trofeje počítají jen dokud máš životy; potom můžeš hrát dál."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üç canla oynarken son kalbinden sonra oyun biter. Sınırsız modda kupalar yalnızca canın varken sayılır; sonra oynamaya devam edebilirsin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تین جانوں میں آخری دل کے بعد کھیل ختم ہو جاتا ہے۔ لامحدود موڈ میں جانیں رہنے تک ہی ٹرافیاں گنی جاتی ہیں؛ پھر بھی آپ کھیل سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Với ba mạng, trò chơi kết thúc sau trái tim cuối cùng. Ở chế độ không giới hạn, cúp chỉ được tính khi bạn còn mạng; sau đó bạn vẫn có thể chơi tiếp."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyda thri bywyd, mae'r gêm yn gorffen ar ôl dy galon olaf. Yn y modd diderfyn, dim ond tra bod bywydau gen ti y mae tlysau'n cyfrif; wedyn gelli di barhau i chwarae."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "З трыма жыццямі гульня заканчваецца пасля апошняга сэрца. У бясконцым рэжыме трафеі залічваюцца, пакуль ёсць жыцці; потым можна гуляць далей."
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngezimpilo ezintathu, umdlalo uphela ngemva kwenhliziyo yakho yokugcina. Kumodi engenamkhawulo, izindebe zibalwa kuphela usenezimpilo; ngemva kwalokho ungaqhubeka udlale."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med tre liv slutar spelet efter ditt sista hjärta. I obegränsat läge räknas pokaler bara så länge du har liv kvar. Sedan kan du fortsätta spela."
          }
        }
