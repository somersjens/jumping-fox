    "modeIntro.superTimes.b1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Practice adding, subtracting and tables all mixed up."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oefen optellen, aftrekken en tafels door elkaar."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Oefen optel, aftrek en maaltafels deurmekaar."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ushtro mbledhjen, zbritjen dhe tabelat të përziera."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "መደመር፣ መቀነስ እና የማባዛት ሰንጠረዦችን ደባልቀህ ተለማመድ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تدرّب على الجمع والطرح والجداول معًا."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Փորձիր գումարում, հանում և աղյուսակներ՝ խառը։"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "যোগ, বিয়োগ আৰু নামতা মিহলাই অভ্যাস কৰা।"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplama, çıxma və vurma cədvəllərini qarışıq məşq et."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Praktikatu batuketak, kenketak eta taulak nahasita."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যোগ, বিয়োগ ও নামতা মিলিয়ে অনুশীলন করো।"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ပေါင်း၊ နုတ်နဲ့ မြှောက်ကိန်းဇယားကို ရောစပ်လေ့ကျင့်ပါ။"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vježbaj sabiranje, oduzimanje i tablice, sve pomiješano."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Упражнявай събиране, изваждане и таблици, разбъркани заедно."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Practica sumes, restes i taules, tot barrejat."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "混合练习加法、减法和乘法表。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Øv addition, subtraktion og tabeller blandet sammen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übe Addition, Subtraktion und Reihen bunt gemischt."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Harjuta läbisegi liitmist, lahutamist ja korrutustabeleid."
          }
        },
        "fo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ven samlegging, frádrátt og tabellir hvørt um annað."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Harjoittele yhteen- ja vähennyslaskua sekä kertotauluja sekaisin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entraîne-toi avec des additions, soustractions et tables mélangées."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Practica sumas, restas e táboas mesturadas."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ივარჯიშე მიმატებაში, გამოკლებასა და ტაბულებში — ყველაფერი არეულად."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εξασκήσου σε πρόσθεση, αφαίρεση και προπαίδεια, όλα μαζί."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સરવાળો, બાદબાકી અને પાડા મિશ્ર કરીને અભ્યાસ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תרגלו חיבור, חיסור ולוחות כפל בערבוביה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जोड़, घटाव और पहाड़े मिलाकर अभ्यास करो।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyakorold vegyesen az összeadást, kivonást és a szorzótáblákat."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleachtaigh suimiú, dealú agus táblaí measctha le chéile."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Æfðu samlagningu, frádrátt og margföldun í bland."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latih penjumlahan, pengurangan, dan perkalian secara campur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allenati con addizioni, sottrazioni e tabelline tutte insieme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "たし算、ひき算、九九をまぜてれんしゅうしよう。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕೂಡಿಸುವಿಕೆ, ಕಳೆಯುವಿಕೆ ಮತ್ತು ಪಟ್ಟಿಗಳನ್ನು ಮಿಶ್ರವಾಗಿ ಅಭ್ಯಾಸ ಮಾಡು."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қосу, азайту және көбейту кестесін араластырып жаттық."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ហាត់បូក ដក និងតារាងគុណលាយគ្នា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덧셈, 뺄셈, 구구단을 섞어 연습해요."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vježbaj zbrajanje, oduzimanje i tablice, sve pomiješano."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຝຶກບວກ, ລົບ ແລະ ສູດຄູນປະສົມກັນ."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenē saskaitīšanu, atņemšanu un reizināšanu jauktā secībā."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Treniruok sudėtį, atimtį ir daugybos lenteles kartu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вежбај измешани задачи со собирање, одземање и таблици."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Latih tambah, tolak dan sifir secara campur."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കൂട്ടൽ, കുറയ്ക്കൽ, ഗുണനപ്പട്ടികകൾ എല്ലാം കലർത്തി പരിശീലിക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बेरीज, वजाबाकी आणि पाढे मिसळून सराव कर."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нэмэх, хасах, хүрдийг хольж давт."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "जोड, घटाउ र गुणन तालिका मिसाएर अभ्यास गर।"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Øv på addisjon, subtraksjon og gangetabeller i en miks."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренуй додавання, віднімання й таблиці впереміш."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଯୋଗ, ବିୟୋଗ ଓ ନାମତାକୁ ମିଶାଇ ଅଭ୍ୟାସ କର।"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "قوشۇش، ئېلىش ۋە كۆپەيتىش جەدۋىلىنى ئارىلاشتۇرۇپ مەشىق قىل."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qo‘shish, ayirish va ko‘paytirish jadvallarini aralash mashq qil."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "جمع، تفریق و جدول ضرب را با هم تمرین کن."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ćwicz razem dodawanie, odejmowanie i tabliczkę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratica adição, subtração e tabuadas, tudo misturado."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜੋੜ, ਘਟਾਓ ਅਤੇ ਪਹਾੜੇ ਮਿਲਾ ਕੇ ਅਭਿਆਸ ਕਰੋ।"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Exersează adunări, scăderi și înmulțiri amestecate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренируй сложение, вычитание и таблицы вперемешку."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vežbaj sabiranje, oduzimanje i tablice, sve pomešano."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "එකතු කිරීම, අඩු කිරීම සහ ගුණන වගු මිශ්‍රව පුහුණු වන්න."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Trénuj sčítanie, odčítanie a násobilku v jednom mixe."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vadi seštevanje, odštevanje in poštevanko, vse pomešano."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Practica sumas, restas y tablas, todo mezclado."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanya mazoezi ya kujumlisha, kutoa na majedwali kwa mchanganyiko."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கூட்டல், கழித்தல், வாய்ப்பாடுகள் அனைத்தையும் கலந்து பயிற்சி செய்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కూడిక, తీసివేత, ఎక్కాలను కలిపి సాధన చేయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฝึกบวก ลบ และสูตรคูณแบบคละกัน"
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "སྣོན། འཐེན་དང་སྒྱུར་རྩིས་འདྲེས་ནས་སྦྱོངས།"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Procvičuj sčítání, odčítání a násobilku dohromady."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplama, çıkarma ve çarpım tablolarını karışık çalış."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جمع، تفریق اور پہاڑے ملا کر مشق کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luyện cộng, trừ và bảng nhân lẫn nhau."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ymarfer adio, tynnu a thablau yn gymysg."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Трэніруй складанне, адніманне і табліцы ўперамешку."
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Zijwayeze ukuhlanganisa, ukususa namathebula kuxubile."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öva på addition, subtraktion och tabeller blandat."
          }
        }
      }
    },
