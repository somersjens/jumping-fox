    "parentGate.holdInstruction %@ %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the %@ for %lld seconds."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de %@ %lld seconden ingedrukt."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk en hou die %@ vir %lld sekondes."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Mbaje %@ shtypur për %lld sekonda."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ን ለ%lld ሰከንድ ተጭነው ይያዙ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مطولًا على %@ لمدة %lld ثوانٍ."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սեղմած պահեք %@-ը %lld վայրկյան։"
