    "options.helperMode.info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Helper Mode the correct answer is always shown in green. Trophies earned in this mode are counted separately and marked with a star."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de hulpmodus wordt het juiste antwoord altijd groen weergegeven. Trofeeën die je in deze modus verdient worden apart geteld en gemarkeerd met een ster."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "In Helpermodus word die regte antwoord altyd groen gewys. Trofeë wat jy in dié modus verdien, word apart getel en met ’n ster gemerk."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Në modalitetin e ndihmës, përgjigjja e saktë shfaqet gjithmonë me të gjelbër. Trofetë e fituar këtu numërohen veç dhe shënohen me yll."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "በረዳት ሁነታ ትክክለኛው መልስ ሁልጊዜ በአረንጓዴ ይታያል። በዚህ ሁነታ የሚገኙ ዋንጫዎች ለብቻቸው ተቆጥረው በኮከብ ይለያሉ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في وضع المساعد، تظهر الإجابة الصحيحة دائمًا بالأخضر. تُحسب الكؤوس المكتسبة فيه بشكل منفصل وتُميّز بنجمة."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Օգնականի ռեժիմում ճիշտ պատասխանը միշտ կանաչ է։ Այս ռեժիմում վաստակած գավաթները հաշվվում են առանձին և նշվում աստղով։"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "সহায়ক মোডত সঠিক উত্তৰ সদায় সেউজীয়া দেখুৱায়। এই মোডৰ ট্ৰফী পৃথকে গণনা হয় আৰু তাৰকা চিহ্ন থাকে।"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Köməkçi rejimdə düzgün cavab həmişə yaşıl göstərilir. Bu rejimdə qazanılan kuboklar ayrıca sayılır və ulduzla işarələnir."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Laguntzaile moduan, erantzun zuzena beti berdez agertzen da. Modu honetan lortutako garaikurrak aparte zenbatzen dira eta izar batekin markatzen dira."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সহায়ক মোডে সঠিক উত্তর সব সময় সবুজ দেখানো হয়। এই মোডের ট্রফি আলাদা গোনা হয় এবং তারকা দিয়ে চিহ্নিত থাকে।"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အကူမုဒ်မှာ အဖြေမှန်ကို အမြဲအစိမ်းရောင်နဲ့ ပြမယ်။ ဒီမုဒ်က ဆုဖလားတွေကို သီးခြားရေတွက်ပြီး ကြယ်ပွင့်နဲ့ မှတ်ထားမယ်။"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "U načinu s pomoćnikom tačan odgovor je uvijek zelen. Trofeji osvojeni u ovom načinu broje se odvojeno i označeni su zvjezdicom."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "В режим с помощ верният отговор винаги е зелен. Спечелените тук трофеи се броят отделно и са отбелязани със звезда."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "En el mode d’ajuda, la resposta correcta sempre es mostra en verd. Els trofeus guanyats en aquest mode es compten a part i es marquen amb una estrella."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助模式会一直用绿色显示正确答案。在此模式中获得的奖杯会单独计算，并标上星号。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I hjælpetilstand vises det rigtige svar altid med grønt. Pokaler fra denne tilstand tælles separat og markeres med en stjerne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Hilfemodus wird die richtige Antwort immer grün angezeigt. Dort verdiente Pokale werden getrennt gezählt und mit einem Stern markiert."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Abilise režiimis näidatakse õiget vastust alati roheliselt. Selles režiimis teenitud karikad loetakse eraldi ja märgitakse tärniga."
          }
        },
        "fo": {
          "stringUnit": {
            "state": "translated",
            "value": "Í hjálparstøðu verður rætta svarið altíð víst grønt. Steyp, sum tú vinnur her, verða tald fyri seg og merkt við stjørnu."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apuritilassa oikea vastaus näkyy aina vihreänä. Tässä tilassa ansaitut pokaalit lasketaan erikseen ja merkitään tähdellä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En mode Aide, la bonne réponse est toujours affichée en vert. Les trophées gagnés dans ce mode sont comptés séparément et marqués d’une étoile."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "No modo de axuda, a resposta correcta sempre aparece en verde. Os trofeos gañados neste modo cóntanse á parte e márcanse cunha estrela."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დამხმარე რეჟიმში სწორი პასუხი ყოველთვის მწვანედ ჩანს. ამ რეჟიმში მიღებული თასები ცალკე ითვლება და ვარსკვლავით აღინიშნება."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στη λειτουργία βοήθειας, η σωστή απάντηση φαίνεται πάντα με πράσινο. Τα τρόπαια που κερδίζεις εδώ μετριούνται χωριστά και έχουν ένα αστέρι."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મદદ મોડમાં સાચો જવાબ હંમેશા લીલો દેખાય છે. આ મોડમાં મળેલી ટ્રોફીઓ અલગ ગણાય છે અને તારાથી ચિહ્નિત થાય છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "במצב עזרה התשובה הנכונה תמיד מוצגת בירוק. גביעים שמרוויחים במצב הזה נספרים בנפרד ומסומנים בכוכבית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहायक मोड में सही उत्तर हमेशा हरे रंग में दिखता है। इस मोड की ट्रॉफियाँ अलग गिनी जाती हैं और उन पर तारा लगा होता है।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Segítő módban a helyes válasz mindig zöld. Az itt szerzett trófeákat külön számoljuk, és csillaggal jelöljük."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa Mhód Cúntóra, taispeántar an freagra ceart i nglas i gcónaí. Déantar na trófaithe a fhaightear sa mhód seo a chomhaireamh ar leithligh agus marcáiltear iad le réalta."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Í hjálparstillingu er rétta svarið alltaf grænt. Bikarar sem fást þar teljast sér og eru merktir með stjörnu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalam Mode Bantuan, jawaban benar selalu ditampilkan hijau. Trofi dari mode ini dihitung terpisah dan diberi tanda bintang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella modalità Aiuto, la risposta corretta è sempre mostrata in verde. I trofei guadagnati vengono contati a parte e contrassegnati con una stella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おたすけモードでは、正しい答えがいつも緑色で表示されます。このモードでもらったトロフィーは別に数え、星印が付きます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಹಾಯಕ ಮೋಡ್‌ನಲ್ಲಿ ಸರಿಯಾದ ಉತ್ತರ ಯಾವಾಗಲೂ ಹಸಿರಿನಲ್ಲಿ ಕಾಣುತ್ತದೆ. ಈ ಮೋಡ್‌ನಲ್ಲಿ ಗಳಿಸಿದ ಟ್ರೋಫಿಗಳನ್ನು ಬೇರೆ ಎಣಿಸಿ ನಕ್ಷತ್ರ ಗುರುತು ಹಾಕಲಾಗುತ್ತದೆ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Көмекші режимінде дұрыс жауап әрдайым жасыл түспен көрсетіледі. Бұл режимде алынған жүлделер бөлек саналып, жұлдызшамен белгіленеді."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ក្នុងរបៀបជំនួយ ចម្លើយត្រឹមត្រូវតែងតែបង្ហាញជាពណ៌បៃតង។ ពានដែលរកបានក្នុងរបៀបនេះត្រូវបានរាប់ដាច់ដោយឡែក និងសម្គាល់ដោយផ្កាយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도우미 모드에서는 정답이 항상 초록색으로 보여요. 이 모드에서 받은 트로피는 따로 계산되고 별표가 붙어요."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "U načinu pomoći točan je odgovor uvijek zelen. Pehari osvojeni u tom načinu broje se odvojeno i označeni su zvjezdicom."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ໃນໂໝດຕົວຊ່ວຍ ຄຳຕອບທີ່ຖືກຈະສະແດງເປັນສີຂຽວສະເໝີ. ຖ້ວຍທີ່ໄດ້ໃນໂໝດນີ້ຈະນັບແຍກ ແລະ ໝາຍດ້ວຍດາວ."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Palīga režīmā pareizā atbilde vienmēr ir zaļa. Šajā režīmā nopelnītās trofejas skaita atsevišķi un atzīmē ar zvaigznīti."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagalbos režimu teisingas atsakymas visada rodomas žaliai. Šiuo režimu gauti trofėjai skaičiuojami atskirai ir žymimi žvaigždute."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Во режимот со помош точниот одговор секогаш е зелен. Трофеите освоени во овој режим се бројат одделно и се означени со ѕвездичка."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalam Mod Pembantu, jawapan betul sentiasa ditunjukkan hijau. Trofi dalam mod ini dikira berasingan dan ditanda bintang."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സഹായി മോഡിൽ ശരിയായ ഉത്തരം എപ്പോഴും പച്ചയായി കാണിക്കും. ഈ മോഡിൽ നേടിയ ട്രോഫികൾ വേറെയായി എണ്ണി നക്ഷത്രം അടയാളപ്പെടുത്തും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "मदतनीस मोडमध्ये योग्य उत्तर नेहमी हिरवे दिसते. या मोडमधल्या ट्रॉफी वेगळ्या मोजल्या जातात आणि त्यांना तारा असतो."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Туслагчийн горимд зөв хариултыг үргэлж ногооноор харуулна. Энэ горимд авсан цомыг тусад нь тоолж, одоор тэмдэглэнэ."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सहायक मोडमा सही उत्तर सधैं हरियो देखिन्छ। यस मोडका ट्रफी छुट्टै गनिन्छन् र ताराले चिनिन्छन्।"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "I hjelpemodus vises riktig svar alltid med grønt. Trofeer du får i denne modusen, telles separat og merkes med en stjerne."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У режимі помічника правильна відповідь завжди зелена. Трофеї з цього режиму рахуються окремо й позначаються зірочкою."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସହାୟକ ମୋଡ୍‌ରେ ଠିକ୍ ଉତ୍ତର ସବୁବେଳେ ସବୁଜ ରଙ୍ଗରେ ଦେଖାଯାଏ। ଏହି ମୋଡ୍‌ରେ ଜିତିଥିବା ଟ୍ରଫି ଅଲଗା ଗଣାଯାଏ ଓ ତାରା ଚିହ୍ନ ଦିଆଯାଏ।"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "ياردەمچى ھالەتتە توغرا جاۋاب ھەمىشە يېشىل كۆرسىتىلىدۇ. بۇ ھالەتتە ئېرىشكەن لوڭقىلار ئايرىم ھېسابلىنىپ، يۇلتۇز بىلەن بەلگىلىنىدۇ."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yordamchi rejimda to‘g‘ri javob doim yashil ko‘rsatiladi. Bu rejimda olingan sovrinlar alohida sanaladi va yulduzcha bilan belgilanadi."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در حالت راهنما، پاسخ درست همیشه سبز است. جام‌های این حالت جدا شمرده می‌شوند و ستاره دارند."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W trybie pomocy poprawna odpowiedź jest zawsze zielona. Zdobyte tu puchary są liczone osobno i oznaczone gwiazdką."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No modo de ajuda, a resposta certa aparece sempre a verde. Os troféus ganhos neste modo são contados à parte e marcados com uma estrela."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਹਾਇਕ ਮੋਡ ਵਿੱਚ ਸਹੀ ਜਵਾਬ ਹਮੇਸ਼ਾ ਹਰੇ ਰੰਗ ਵਿੱਚ ਦਿਖਦਾ ਹੈ। ਇਸ ਮੋਡ ਦੀਆਂ ਟ੍ਰਾਫੀਆਂ ਵੱਖ ਗਿਣੀਆਂ ਜਾਂਦੀਆਂ ਹਨ ਅਤੇ ਤਾਰੇ ਨਾਲ ਨਿਸ਼ਾਨ ਲੱਗਦਾ ਹੈ।"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În modul Ajutor, răspunsul corect este mereu verde. Trofeele câștigate astfel sunt numărate separat și marcate cu o stea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В режиме подсказки правильный ответ всегда выделен зелёным. Полученные здесь трофеи считаются отдельно и отмечаются звёздочкой."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "U režimu pomoći tačan odgovor je uvek zelen. Trofeji osvojeni u ovom režimu broje se odvojeno i označeni su zvezdicom."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "උදව් මාදිලියේ නිවැරදි පිළිතුර හැමවිටම කොළ පාටින් පෙන්වයි. මෙහි උපයන කුසලාන වෙනම ගණන් කර තරුවකින් සලකුණු කරයි."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V režime pomocníka je správna odpoveď vždy zelená. Trofeje získané v tomto režime sa počítajú osobitne a označujú hviezdičkou."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V načinu pomočnika je pravilen odgovor vedno prikazan zeleno. Pokali, osvojeni v tem načinu, se štejejo posebej in so označeni z zvezdico."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el modo Ayuda, la respuesta correcta siempre aparece en verde. Los trofeos ganados en este modo se cuentan aparte y llevan una estrella."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Katika Hali ya Msaada, jibu sahihi huonyeshwa kwa kijani. Vikombe vya hali hii huhesabiwa kando na kutiwa nyota."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உதவி முறையில் சரியான விடை எப்போதும் பச்சை நிறத்தில் காட்டப்படும். இதில் கிடைக்கும் கோப்பைகள் தனியாக எண்ணப்பட்டு நட்சத்திரக் குறியுடன் காட்டப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సహాయక మోడ్‌లో సరైన జవాబు ఎప్పుడూ ఆకుపచ్చగా కనిపిస్తుంది. ఈ మోడ్‌లో పొందిన ట్రోఫీలను విడిగా లెక్కించి నక్షత్రంతో గుర్తిస్తారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในโหมดตัวช่วย คำตอบที่ถูกจะแสดงเป็นสีเขียวเสมอ ถ้วยรางวัลจากโหมดนี้จะนับแยกและมีรูปดาว"
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "རོགས་རམ་རྣམ་པའི་ནང་ལན་འགྲིག་པ་རྟག་ཏུ་ལྗང་ཁུས་མཚོན། རྣམ་པ་འདིར་ཐོབ་པའི་བྱ་དགའ་ལོགས་སུ་བརྩི་ཞིང་སྐར་མས་རྟགས་བཀོད།"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V režimu nápovědy je správná odpověď vždy zelená. Trofeje získané v tomto režimu se počítají zvlášť a označují hvězdičkou."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yardımcı Modu'nda doğru cevap her zaman yeşil gösterilir. Bu modda kazanılan kupalar ayrı sayılır ve yıldızla işaretlenir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مددگار موڈ میں درست جواب ہمیشہ سبز دکھتا ہے۔ اس موڈ کی ٹرافیاں الگ گنی جاتی ہیں اور ستارے سے نشان زد ہوتی ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong chế độ trợ giúp, đáp án đúng luôn hiện màu xanh. Cúp nhận được ở chế độ này được tính riêng và đánh dấu bằng ngôi sao."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Yn y Modd Cynorthwyydd, mae'r ateb cywir bob amser yn wyrdd. Caiff tlysau a enillir yn y modd hwn eu cyfrif ar wahân a'u marcio â seren."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "У рэжыме падказкі правільны адказ заўсёды паказаны зялёным. Заробленыя тут трафеі лічацца асобна і пазначаюцца зоркай."
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumodi yomsizi, impendulo efanele ihlale iboniswa ngokuluhlaza. Izindebe ezitholwe kule modi zibalwa ngokwehlukana futhi zimakwe ngenkanyezi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I hjälpläget visas rätt svar alltid i grönt. Pokaler du får i detta läge räknas separat och markeras med en stjärna."
          }
        }
      }
    },
