    "modeIntro.superFraction.b1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Practice adding, subtracting, tables and fractions all mixed up."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oefen optellen, aftrekken, tafels en breuken door elkaar."
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Oefen optel, aftrek, maaltafels en breuke deurmekaar."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Ushtro mbledhjen, zbritjen, tabelat dhe thyesat të përziera."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "መደመር፣ መቀነስ፣ የማባዛት ሰንጠረዦች እና ክፍልፋዮችን ደባልቀህ ተለማመድ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تدرّب على الجمع والطرح والجداول والكسور معًا."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Փորձիր գումարում, հանում, աղյուսակներ և կոտորակներ՝ խառը։"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "যোগ, বিয়োগ, নামতা আৰু ভগ্নাংশ মিহলাই অভ্যাস কৰা।"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplama, çıxma, vurma cədvəlləri və kəsrləri qarışıq məşq et."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Praktikatu batuketak, kenketak, taulak eta zatikiak nahasita."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যোগ, বিয়োগ, নামতা ও ভগ্নাংশ মিলিয়ে অনুশীলন করো।"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ပေါင်း၊ နုတ်၊ မြှောက်ကိန်းဇယားနဲ့ အပိုင်းကိန်းကို ရောစပ်လေ့ကျင့်ပါ။"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vježbaj sabiranje, oduzimanje, tablice i razlomke, sve pomiješano."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Упражнявай събиране, изваждане, таблици и дроби, разбъркани заедно."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Practica sumes, restes, taules i fraccions, tot barrejat."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "混合练习加法、减法、乘法表和分数。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Øv addition, subtraktion, tabeller og brøker blandet sammen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übe Addition, Subtraktion, Reihen und Brüche bunt gemischt."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Harjuta läbisegi liitmist, lahutamist, korrutustabeleid ja murde."
          }
        },
        "fo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ven samlegging, frádrátt, tabellir og brot hvørt um annað."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Harjoittele yhteen- ja vähennyslaskua, kertotauluja ja murtolukuja sekaisin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entraîne-toi avec des additions, soustractions, tables et fractions mélangées."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Practica sumas, restas, táboas e fraccións mesturadas."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ივარჯიშე მიმატებაში, გამოკლებაში, ტაბულებსა და წილადებში — ყველაფერი არეულად."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εξασκήσου σε πρόσθεση, αφαίρεση, προπαίδεια και κλάσματα, όλα μαζί."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સરવાળો, બાદબાકી, પાડા અને અપૂર્ણાંક મિશ્ર કરીને અભ્યાસ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תרגלו חיבור, חיסור, לוחות כפל ושברים בערבוביה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जोड़, घटाव, पहाड़े और भिन्न मिलाकर अभ्यास करो।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyakorold vegyesen az összeadást, kivonást, szorzótáblákat és törteket."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleachtaigh suimiú, dealú, táblaí agus codáin measctha le chéile."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Æfðu samlagningu, frádrátt, margföldun og brot í bland."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latih penjumlahan, pengurangan, perkalian, dan pecahan secara campur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allenati con addizioni, sottrazioni, tabelline e frazioni tutte insieme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "たし算、ひき算、九九、分数をまぜてれんしゅうしよう。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕೂಡಿಸುವಿಕೆ, ಕಳೆಯುವಿಕೆ, ಪಟ್ಟಿಗಳು ಮತ್ತು ಭಿನ್ನರಾಶಿಗಳನ್ನು ಮಿಶ್ರವಾಗಿ ಅಭ್ಯಾಸ ಮಾಡು."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қосу, азайту, көбейту кестесі мен бөлшектерді араластырып жаттық."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ហាត់បូក ដក តារាងគុណ និងប្រភាគលាយគ្នា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덧셈, 뺄셈, 구구단, 분수를 섞어 연습해요."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vježbaj zbrajanje, oduzimanje, tablice i razlomke, sve pomiješano."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຝຶກບວກ, ລົບ, ສູດຄູນ ແລະ ເສດສ່ວນປະສົມກັນ."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenē saskaitīšanu, atņemšanu, reizināšanu un daļskaitļus jauktā secībā."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Treniruok sudėtį, atimtį, daugybos lenteles ir trupmenas kartu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вежбај измешани задачи со собирање, одземање, таблици и дропки."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Latih tambah, tolak, sifir dan pecahan secara campur."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കൂട്ടൽ, കുറയ്ക്കൽ, ഗുണനപ്പട്ടികകൾ, ഭിന്നങ്ങൾ എല്ലാം കലർത്തി പരിശീലിക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बेरीज, वजाबाकी, पाढे आणि अपूर्णांक मिसळून सराव कर."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нэмэх, хасах, хүрд, бутархайг хольж давт."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "जोड, घटाउ, गुणन तालिका र भिन्न मिसाएर अभ्यास गर।"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Øv på addisjon, subtraksjon, gangetabeller og brøker i en miks."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренуй додавання, віднімання, таблиці й дроби впереміш."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଯୋଗ, ବିୟୋଗ, ନାମତା ଓ ଭଗ୍ନାଂଶକୁ ମିଶାଇ ଅଭ୍ୟାସ କର।"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "قوشۇش، ئېلىش، كۆپەيتىش جەدۋىلى ۋە كەسىرنى ئارىلاشتۇرۇپ مەشىق قىل."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qo‘shish, ayirish, ko‘paytirish jadvallari va kasrlarni aralash mashq qil."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "جمع، تفریق، جدول ضرب و کسر را با هم تمرین کن."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ćwicz razem dodawanie, odejmowanie, tabliczkę i ułamki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratica adição, subtração, tabuadas e frações, tudo misturado."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜੋੜ, ਘਟਾਓ, ਪਹਾੜੇ ਅਤੇ ਭਿੰਨਾਂ ਮਿਲਾ ਕੇ ਅਭਿਆਸ ਕਰੋ।"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Exersează adunări, scăderi, înmulțiri și fracții amestecate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренируй сложение, вычитание, таблицы и дроби вперемешку."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vežbaj sabiranje, oduzimanje, tablice i razlomke, sve pomešano."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "එකතු කිරීම, අඩු කිරීම, ගුණන වගු සහ භාග මිශ්‍රව පුහුණු වන්න."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Trénuj sčítanie, odčítanie, násobilku a zlomky v jednom mixe."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vadi seštevanje, odštevanje, poštevanko in ulomke, vse pomešano."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Practica sumas, restas, tablas y fracciones, todo mezclado."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanya mazoezi ya kujumlisha, kutoa, majedwali na sehemu kwa mchanganyiko."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கூட்டல், கழித்தல், வாய்ப்பாடுகள், பின்னங்கள் அனைத்தையும் கலந்து பயிற்சி செய்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కూడిక, తీసివేత, ఎక్కాలు, భిన్నాలను కలిపి సాధన చేయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฝึกบวก ลบ สูตรคูณ และเศษส่วนแบบคละกัน"
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "སྣོན། འཐེན། སྒྱུར་དང་ཆ་ཤས་འདྲེས་ནས་སྦྱོངས།"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Procvičuj sčítání, odčítání, násobilku a zlomky dohromady."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplama, çıkarma, çarpım tabloları ve kesirleri karışık çalış."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جمع، تفریق، پہاڑے اور کسریں ملا کر مشق کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luyện cộng, trừ, bảng nhân và phân số lẫn nhau."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ymarfer adio, tynnu, tablau a ffracsiynau yn gymysg."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Трэніруй складанне, адніманне, табліцы і дробы ўперамешку."
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Zijwayeze ukuhlanganisa, ukususa, amathebula namaqhezu kuxubile."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öva på addition, subtraktion, tabeller och bråk blandat."
          }
        }
      }
    },
