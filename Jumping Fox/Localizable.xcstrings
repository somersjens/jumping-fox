          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Числа остаются круглыми, поэтому ответы всегда целые."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brojevi ostaju okrugli, pa su rezultati uvek celi."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "අංක වටකුරු නිසා පිළිතුරු හැමවිටම පූර්ණ අංක වේ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Čísla zostávajú okrúhle, takže výsledky sú vždy celé."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Števila ostanejo okrogla, zato so rezultati vedno cela števila."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los números son redondos, así que las respuestas siempre son enteras."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Nambari hubaki kamili, kwa hiyo majibu huwa nambari nzima."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எண்கள் முழு பத்துகளாக இருப்பதால் விடைகள் எப்போதும் முழு எண்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సంఖ్యలు గుండ్రంగా ఉంటాయి, కాబట్టి జవాబులు పూర్ణసంఖ్యలే."
          }
        },
        "th": {
