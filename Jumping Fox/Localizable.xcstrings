        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Practica sumes, restes, taules, fraccions i percentatges, tot barrejat."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "混合练习加法、减法、乘法表、分数和百分数。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Øv addition, subtraktion, tabeller, brøker og procenter blandet sammen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übe Addition, Subtraktion, Reihen, Brüche und Prozente bunt gemischt."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Harjuta läbisegi liitmist, lahutamist, korrutustabeleid, murde ja protsente."
          }
        },
        "fo": {
          "stringUnit": {
            "state": "translated",
            "value": "Ven samlegging, frádrátt, tabellir, brot og prosent hvørt um annað."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Harjoittele yhteen- ja vähennyslaskua, kertotauluja, murtolukuja ja prosentteja sekaisin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entraîne-toi avec des additions, soustractions, tables, fractions et pourcentages mélangés."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Practica sumas, restas, táboas, fraccións e porcentaxes mesturadas."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ივარჯიშე მიმატებაში, გამოკლებაში, ტაბულებში, წილადებსა და პროცენტებში — ყველაფერი არეულად."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εξασκήσου σε πρόσθεση, αφαίρεση, προπαίδεια, κλάσματα και ποσοστά, όλα μαζί."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સરવાળો, બાદબાકી, પાડા, અપૂર્ણાંક અને ટકાવારી બધું મિશ્ર કરીને અભ્યાસ કરો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תרגלו חיבור, חיסור, לוחות כפל, שברים ואחוזים בערבוביה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जोड़, घटाव, पहाड़े, भिन्न और प्रतिशत सब मिलाकर अभ्यास करो।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Gyakorold vegyesen az összeadást, kivonást, szorzótáblákat, törteket és százalékokat."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleachtaigh suimiú, dealú, táblaí, codáin agus céatadáin measctha le chéile."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Æfðu samlagningu, frádrátt, margföldun, brot og prósentur í bland."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Latih penjumlahan, pengurangan, perkalian, pecahan, dan persentase secara campur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allenati con addizioni, sottrazioni, tabelline, frazioni e percentuali tutte insieme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "たし算、ひき算、九九、分数、パーセントをまぜてれんしゅうしよう。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕೂಡಿಸುವಿಕೆ, ಕಳೆಯುವಿಕೆ, ಪಟ್ಟಿಗಳು, ಭಿನ್ನರಾಶಿಗಳು ಮತ್ತು ಶೇಕಡಾವಾರನ್ನು ಮಿಶ್ರವಾಗಿ ಅಭ್ಯಾಸ ಮಾಡು."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қосу, азайту, көбейту кестесі, бөлшектер мен пайыздарды араластырып жаттық."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ហាត់បូក ដក តារាងគុណ ប្រភាគ និងភាគរយលាយគ្នា។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덧셈, 뺄셈, 구구단, 분수, 백분율을 모두 섞어 연습해요."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vježbaj zbrajanje, oduzimanje, tablice, razlomke i postotke, sve pomiješano."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ຝຶກບວກ, ລົບ, ສູດຄູນ, ເສດສ່ວນ ແລະ ເປີເຊັນປະສົມກັນ."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenē saskaitīšanu, atņemšanu, reizināšanu, daļskaitļus un procentus jauktā secībā."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Treniruok sudėtį, atimtį, daugybos lenteles, trupmenas ir procentus – viską kartu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вежбај измешани задачи со собирање, одземање, таблици, дропки и проценти."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Latih tambah, tolak, sifir, pecahan dan peratus secara campur."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കൂട്ടൽ, കുറയ്ക്കൽ, ഗുണനപ്പട്ടികകൾ, ഭിന്നങ്ങൾ, ശതമാനങ്ങൾ എല്ലാം കലർത്തി പരിശീലിക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बेरीज, वजाबाकी, पाढे, अपूर्णांक आणि टक्केवारी सगळे मिसळून सराव कर."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нэмэх, хасах, хүрд, бутархай, хувийг хольж давт."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "जोड, घटाउ, गुणन तालिका, भिन्न र प्रतिशत मिसाएर अभ्यास गर।"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Øv på addisjon, subtraksjon, gangetabeller, brøker og prosent i en miks."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренуй додавання, віднімання, таблиці, дроби й відсотки впереміш."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଯୋଗ, ବିୟୋଗ, ନାମତା, ଭଗ୍ନାଂଶ ଓ ଶତକଡ଼ାକୁ ମିଶାଇ ଅଭ୍ୟାସ କର।"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "قوشۇش، ئېلىش، كۆپەيتىش جەدۋىلى، كەسىر ۋە پىرسەنتنى ئارىلاشتۇرۇپ مەشىق قىل."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qo‘shish, ayirish, ko‘paytirish jadvallari, kasrlar va foizlarni aralash mashq qil."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "جمع، تفریق، جدول ضرب، کسر و درصد را با هم تمرین کن."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ćwicz razem dodawanie, odejmowanie, tabliczkę, ułamki i procenty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratica adição, subtração, tabuadas, frações e percentagens, tudo misturado."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜੋੜ, ਘਟਾਓ, ਪਹਾੜੇ, ਭਿੰਨਾਂ ਅਤੇ ਪ੍ਰਤੀਸ਼ਤ ਸਭ ਮਿਲਾ ਕੇ ਅਭਿਆਸ ਕਰੋ।"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Exersează adunări, scăderi, înmulțiri, fracții și procente, toate amestecate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренируй сложение, вычитание, таблицы, дроби и проценты вперемешку."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vežbaj sabiranje, oduzimanje, tablice, razlomke i procente, sve pomešano."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "එකතු කිරීම, අඩු කිරීම, ගුණන වගු, භාග සහ ප්‍රතිශත මිශ්‍රව පුහුණු වන්න."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Trénuj sčítanie, odčítanie, násobilku, zlomky a percentá v jednom mixe."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vadi seštevanje, odštevanje, poštevanko, ulomke in odstotke, vse pomešano."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Practica sumas, restas, tablas, fracciones y porcentajes, todo mezclado."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanya mazoezi ya kujumlisha, kutoa, majedwali, sehemu na asilimia kwa mchanganyiko."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கூட்டல், கழித்தல், வாய்ப்பாடுகள், பின்னங்கள், சதவீதங்கள் அனைத்தையும் கலந்து பயிற்சி செய்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కూడిక, తీసివేత, ఎక్కాలు, భిన్నాలు, శాతాలను కలిపి సాధన చేయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฝึกบวก ลบ สูตรคูณ เศษส่วน และเปอร์เซ็นต์แบบคละกัน"
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "སྣོན། འཐེན། སྒྱུར། ཆ་ཤས་དང་བརྒྱ་ཆ་ཚང་མ་འདྲེས་ནས་སྦྱོངས།"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Procvičuj sčítání, odčítání, násobilku, zlomky a procenta dohromady."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplama, çıkarma, çarpım tabloları, kesirler ve yüzdeleri karışık çalış."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جمع، تفریق، پہاڑے، کسریں اور فی صد ملا کر مشق کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luyện cộng, trừ, bảng nhân, phân số và phần trăm lẫn nhau."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ymarfer adio, tynnu, tablau, ffracsiynau a chanrannau i gyd yn gymysg."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Трэніруй складанне, адніманне, табліцы, дробы і працэнты ўперамешку."
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Zijwayeze ukuhlanganisa, ukususa, amathebula, amaqhezu namaphesenti kuxubile."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öva på addition, subtraktion, tabeller, bråk och procent blandat."
          }
        }
      }
    },
