        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Փոքրիկ խաղացողներին պաշտպանելու համար մեծահասակը պետք է անցնի այս ստուգումը՝ գնումը շարունակելուց առաջ։"
