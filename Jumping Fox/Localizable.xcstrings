        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Drži 2 sekunde da otvoriš režim za programere."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "සංවර්ධක මාදිලිය විවෘත කිරීමට තත්පර 2ක් ඔබාගෙන සිටින්න."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrž 2 sekundy a otvoríš režim vývojára."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pritisni in drži 2 sekundi, da odpreš razvijalski način."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado 2 segundos para abrir el modo desarrollador."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bonyeza na ushikilie kwa sekunde 2 kufungua hali ya msanidi."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "டெவலப்பர் முறையைத் திறக்க 2 விநாடிகள் அழுத்திப் பிடிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "డెవలపర్ మోడ్ తెరవడానికి 2 సెకన్లు నొక్కి పట్టుకోండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กดค้าง 2 วินาทีเพื่อเปิดโหมดนักพัฒนา"
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "བཟོ་མཁན་རྣམ་པ་ཁ་ཕྱེ་བར་སྐར་ཆ་2 མནན་ནས་སྡོད།"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrž 2 sekundy pro otevření vývojářského režimu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geliştirici modunu açmak için 2 saniye basılı tut."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ڈیولپر موڈ کھولنے کے لیے 2 سیکنڈ دبائے رکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn giữ 2 giây để mở chế độ nhà phát triển."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Pwysa a dal am 2 eiliad i agor modd datblygwr."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Націсні і ўтрымлівай 2 секунды, каб адкрыць рэжым распрацоўшчыка."
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Cindezela ubambe imizuzwana engu-2 ukuze uvule imodi yonjiniyela."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll intryckt i 2 sekunder för att öppna utvecklarläget."
          }
        }
      }
    },
