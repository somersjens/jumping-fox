    "menu.accessibility.characterHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to change your character; press and hold for two seconds to start over at the welcome screen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik om je personage te wijzigen; houd twee seconden ingedrukt om opnieuw te beginnen bij het welkomscherm"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik om jou karakter te verander; druk en hou twee sekondes om weer by die welkomskerm te begin."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Prek për të ndryshuar personazhin; mbaje shtypur dy sekonda për të nisur nga ekrani i mirëseardhjes."
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ገጸ ባሕሪህን ለመቀየር ንካ፤ ከመቀበያ ማያው እንደገና ለመጀመር ለሁለት ሰከንድ ተጭነህ ያዝ።"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط لتغيير شخصيتك؛ واضغط مطولًا لمدة ثانيتين للبدء من جديد من شاشة الترحيب."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հպվիր՝ կերպարդ փոխելու համար։ Սեղմած պահիր երկու վայրկյան՝ ողջույնի էկրանից նորից սկսելու համար։"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "চৰিত্ৰ সলাবলৈ টেপ কৰা; স্বাগতম পৰ্দাৰ পৰা নতুনকৈ আৰম্ভ কৰিবলৈ দুই ছেকেণ্ড ধৰি ৰাখা।"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Personajını dəyişmək üçün toxun; qarşılama ekranından yenidən başlamaq üçün iki saniyə basıb saxla."
          }
        },
        "eu": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakatu pertsonaia aldatzeko; eduki sakatuta bi segundoz ongietorri-pantailatik berriro hasteko."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চরিত্র বদলাতে ট্যাপ করো; স্বাগত স্ক্রিন থেকে আবার শুরু করতে দুই সেকেন্ড চেপে ধরো।"
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဇာတ်ကောင်ပြောင်းရန် တို့ပါ။ ကြိုဆိုမျက်နှာပြင်ကနေ ပြန်စရန် ၂ စက္ကန့် ဖိထားပါ။"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirni za promjenu lika; pritisni i drži dvije sekunde za povratak na ekran dobrodošlice."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Докосни, за да смениш героя си; задръж за две секунди, за да започнеш отначало от началния екран."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca per canviar de personatge; mantén premut durant dos segons per tornar a començar a la pantalla de benvinguda."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点可更换角色；长按两秒可返回欢迎页重新开始。"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk for at skifte figur. Hold nede i to sekunder for at starte forfra på velkomstskærmen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe, um deine Figur zu ändern. Halte zwei Sekunden gedrückt, um beim Willkommensbildschirm neu zu starten."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegelase muutmiseks puuduta; tervitusekraanilt uuesti alustamiseks hoia kaks sekundit all."
          }
        },
        "fo": {
          "stringUnit": {
            "state": "translated",
            "value": "Trýst fyri at skifta figur; halt inni í tvey sekund fyri at byrja av nýggjum á vælkomstskíggjanum."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaihda hahmoa napauttamalla. Aloita tervetulonäkymästä alusta pitämällä painettuna kaksi sekuntia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touche pour changer de personnage ; maintiens appuyé deux secondes pour recommencer à l’écran d’accueil."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para cambiar de personaxe; mantén premido dous segundos para volver á pantalla de benvida."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "პერსონაჟის შესაცვლელად შეეხე; მისასალმებელი ეკრანიდან თავიდან დასაწყებად ორი წამით დააჭირე."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πάτησε για να αλλάξεις χαρακτήρα. Κράτησε πατημένο για δύο δευτερόλεπτα για να ξεκινήσεις ξανά από την οθόνη καλωσορίσματος."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પાત્ર બદલવા ટેપ કરો; સ્વાગત સ્ક્રીનથી ફરી શરૂ કરવા બે સેકન્ડ દબાવી રાખો."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקישו כדי לשנות דמות; לחצו לחיצה ארוכה במשך שתי שניות כדי להתחיל מחדש במסך הפתיחה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पात्र बदलने के लिए टैप करें; स्वागत स्क्रीन से फिर शुरू करने के लिए दो सेकंड दबाकर रखें।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints a figurád megváltoztatásához; tartsd nyomva két másodpercig, hogy újrakezdd az üdvözlőképernyőn."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapáil chun do charachtar a athrú; brúigh agus coinnigh ar feadh dhá shoicind chun tosú arís ag an scáileán fáilte."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Pikkaðu til að skipta um persónu; haltu inni í tvær sekúndur til að byrja aftur á móttökuskjánum."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk untuk mengganti karakter; tekan dan tahan selama dua detik untuk memulai lagi dari layar sambutan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca per cambiare personaggio; tieni premuto per due secondi per ricominciare dalla schermata di benvenuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップでキャラクターをかえます。2秒間長押しすると、はじめの画面からやり直します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪಾತ್ರ ಬದಲಿಸಲು ತಟ್ಟು; ಸ್ವಾಗತ ಪರದೆಯಿಂದ ಮತ್ತೆ ಆರಂಭಿಸಲು ಎರಡು ಸೆಕೆಂಡ್ ಒತ್ತಿಹಿಡಿ."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кейіпкерді өзгерту үшін түрт; сәлемдесу экранынан қайта бастау үшін екі секунд басып тұр."
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ប៉ះដើម្បីប្ដូរតួអង្គរបស់អ្នក; ចុចឱ្យជាប់ពីរវិនាទី ដើម្បីចាប់ផ្តើមឡើងវិញពីអេក្រង់ស្វាគមន៍។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누르면 캐릭터를 바꿔요. 2초 동안 길게 누르면 시작 화면부터 다시 해요."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirni za promjenu lika; pritisni i drži dvije sekunde za povratak na zaslon dobrodošlice."
          }
        },
        "lo": {
          "stringUnit": {
            "state": "translated",
            "value": "ແຕະເພື່ອປ່ຽນຕົວລະຄອນ; ກົດຄ້າງສອງວິນາທີເພື່ອເລີ່ມໃໝ່ທີ່ໜ້າຕ້ອນຮັບ."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieskaries, lai mainītu tēlu; turiet nospiestu divas sekundes, lai sāktu no jauna sveiciena ekrānā."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakstelėk, kad pakeistum veikėją; palaikyk dvi sekundes, kad grįžtum į pasisveikinimo ekraną."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Допри за да го смениш ликот; притисни и држи две секунди за да почнеш одново од екранот за добредојде."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik untuk tukar watak; tekan dan tahan dua saat untuk mula semula di skrin selamat datang."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കഥാപാത്രം മാറ്റാൻ തട്ടൂ; സ്വാഗത സ്ക്രീനിൽ നിന്ന് വീണ്ടും തുടങ്ങാൻ രണ്ട് സെക്കൻഡ് അമർത്തിപ്പിടിക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पात्र बदलण्यासाठी टॅप कर; स्वागत स्क्रीनपासून पुन्हा सुरू करण्यासाठी दोन सेकंद दाबून ठेव."
          }
        },
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Дүрээ солихын тулд товш; тавтай морилно уу дэлгэцээс дахин эхлэхийн тулд хоёр секунд дар."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "पात्र बदल्न ट्याप गर; स्वागत स्क्रिनबाट फेरि सुरु गर्न दुई सेकेन्ड थिचिराख।"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk for å bytte figur. Hold inne i to sekunder for å starte på nytt fra velkomstskjermen."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкнися, щоб змінити персонажа; натисни й утримуй дві секунди, щоб почати спочатку з екрана привітання."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପାତ୍ର ବଦଳାଇବାକୁ ଟ୍ୟାପ୍ କର; ସ୍ୱାଗତ ସ୍କ୍ରିନ୍‌ରୁ ପୁଣି ଆରମ୍ଭ କରିବାକୁ ଦୁଇ ସେକେଣ୍ଡ ଧରି ରଖ।"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "قەھرىمانىڭنى ئۆزگەرتىش ئۈچۈن چەك؛ قارشى ئېلىش ئېكرانىدىن قايتا باشلاش ئۈچۈن ئىككى سېكۇنت بېسىپ تۇر."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Qahramonni almashtirish uchun teg; salomlashuv ekranidan qayta boshlash uchun ikki soniya bosib tur."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای عوض کردن شخصیت بزن؛ برای شروع دوباره از صفحهٔ خوش‌آمدگویی، دو ثانیه نگه دار."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij, aby zmienić postać; przytrzymaj przez dwie sekundy, aby zacząć od nowa na ekranie powitalnym."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para mudar de personagem; mantém premido durante dois segundos para recomeçar no ecrã de boas-vindas."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਿਰਦਾਰ ਬਦਲਣ ਲਈ ਟੈਪ ਕਰੋ; ਸਵਾਗਤ ਸਕ੍ਰੀਨ ਤੋਂ ਮੁੜ ਸ਼ੁਰੂ ਕਰਨ ਲਈ ਦੋ ਸਕਿੰਟ ਦਬਾ ਕੇ ਰੱਖੋ।"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge pentru a schimba personajul; ține apăsat două secunde pentru a reveni la ecranul de bun venit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми, чтобы сменить персонажа; удерживай две секунды, чтобы начать заново с экрана приветствия."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirni da promeniš lika; drži dve sekunde da počneš ispočetka od ekrana dobrodošlice."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබේ චරිතය වෙනස් කිරීමට තට්ටු කරන්න; පිළිගැනීමේ තිරයෙන් නැවත අරඹන්න තත්පර දෙකක් ඔබාගෙන සිටින්න."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ťuknutím zmeníš postavičku; podrž dve sekundy a začneš znova na uvítacej obrazovke."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapni za zamenjavo junaka; pritisni in drži dve sekundi, da začneš znova na pozdravnem zaslonu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para cambiar de personaje; mantén pulsado dos segundos para volver a empezar desde la pantalla de bienvenida."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Gusa kubadilisha mhusika wako; bonyeza na ushikilie kwa sekunde mbili kuanza tena kwenye skrini ya kukaribisha."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கதாபாத்திரத்தை மாற்றத் தட்டு; வரவேற்புத் திரையிலிருந்து மீண்டும் தொடங்க இரண்டு விநாடிகள் அழுத்திப் பிடி."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పాత్రను మార్చడానికి తాకు; స్వాగత తెర నుంచి మళ్లీ మొదలుపెట్టడానికి రెండు సెకన్లు నొక్కి పట్టుకో."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะเพื่อเปลี่ยนตัวละคร กดค้างสองวินาทีเพื่อเริ่มใหม่ที่หน้าต้อนรับ"
          }
        },
        "bo": {
          "stringUnit": {
            "state": "translated",
            "value": "མི་སྣ་བརྗེ་བར་རེག དགའ་བསུའི་ངོས་ནས་བསྐྱར་དུ་འགོ་འཛུགས་པར་སྐར་ཆ་གཉིས་མནན་ནས་སྡོད།"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím změníš postavičku; podržením na dvě sekundy začneš znovu na uvítací obrazovce."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karakterini değiştirmek için dokun; karşılama ekranından yeniden başlamak için iki saniye basılı tut."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کردار بدلنے کے لیے ٹیپ کریں؛ خیرمقدمی اسکرین سے دوبارہ شروع کرنے کے لیے دو سیکنڈ دبائے رکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm để đổi nhân vật; nhấn giữ hai giây để bắt đầu lại từ màn hình chào mừng."
          }
        },
        "cy": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapia i newid dy gymeriad; pwysa a dal am ddwy eiliad i ddechrau eto ar y sgrin groeso."
          }
        },
        "be": {
          "stringUnit": {
            "state": "translated",
            "value": "Націсні, каб змяніць героя; утрымлівай дзве секунды, каб пачаць нанова з экрана прывітання."
          }
        },
        "zu": {
          "stringUnit": {
            "state": "translated",
            "value": "Thepha ukuze ushintshe umlingiswa; cindezela ubambe imizuzwana emibili ukuze uqale kabusha esikrinini sokwamukela."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck för att byta figur. Håll intryckt i två sekunder för att börja om från välkomstskärmen."
          }
        }
      }
    },
